  ISTP: ['Ti', 'Se', 'Ni', 'Fe', 'Te', 'Si', 'Ne', 'Fi'],
  ISTJ: ['Si', 'Te', 'Fi', 'Ne', 'Se', 'Ti', 'Fe', 'Ni'],
  ESTP: ['Se', 'Ti', 'Fe', 'Ni', 'Si', 'Te', 'Fi', 'Ne'],
  ESTJ: ['Te', 'Si', 'Ne', 'Fi', 'Ti', 'Se', 'Ni', 'Fe'],
};

const functionInfo = {
  Ni: { name: '內傾直覺', desc: '從細節中洞察整體模式，預感事物的走向與深層意義' },
  Ne: { name: '外傾直覺', desc: '在事物之間連結出可能性，發散、跳躍式的探索' },
  Si: { name: '內傾感官', desc: '保留細節記憶，倚賴熟悉感與過去經驗' },
  Se: { name: '外傾感官', desc: '對當下環境敏銳，反應快、活在現場' },
  Ti: { name: '內傾思考', desc: '建立內部一致的邏輯體系，追求精確與分類' },
  Te: { name: '外傾思考', desc: '以效率與成果組織世界，重視可衡量的標準' },
  Fi: { name: '內傾情感', desc: '依據個人價值觀判斷意義與真假，忠於內在' },
  Fe: { name: '外傾情感', desc: '感知群體情緒、維繫人際和諧，照顧氣氛' },
};

const positionLabels = [
  '主導 · Hero',
  '輔助 · Parent',
  '第三 · Child',
  '劣勢 · Anima',
  '對立 · Opposing',
  '批判 · Critic',
  '騙子 · Trickster',
  '惡魔 · Demon',
];

// ═══════════ 狀態 ═══════════
const state = {
  stage: 'welcome',
  currentQ: 0,
  answers: {},
};

const app = document.getElementById('app');

function esc(s) {
  return String(s)
    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

const arrowLeftSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>';
const rotateSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>';

// ═══════════ 渲染 ═══════════
function render() {
  if (state.stage === 'welcome') renderWelcome();
  else if (state.stage === 'quiz') renderQuiz();
  else renderResults();
  window.scrollTo(0, 0);
}

function renderWelcome() {
  app.innerHTML = `
    <div class="welcome">
      <div class="welcome-inner">
        <div class="welcome-since">
          <div class="hairline line"></div>
          <div class="label">Jung · Myers · Briggs</div>
          <div class="hairline line"></div>
        </div>
        <div class="welcome-eyebrow">MBTI · 96 QUESTIONS</div>
        <h1 class="welcome-title">認識<br><em>你自己</em></h1>
        <p class="welcome-sub">96 題人格測驗 · 含身份維度與榮格八維</p>
        <p class="welcome-sub small">約需 12–15 分鐘 · 憑直覺回答最準</p>
        <button class="btn-primary" id="start-btn">BEGIN · 開始</button>
        <div class="welcome-dims">
          <em>E/I</em><span>·</span>
          <em>S/N</em><span>·</span>
          <em>T/F</em><span>·</span>
          <em>J/P</em><span>·</span>
          <em>A/O</em><span>·</span>
          <em>H/C</em>
        </div>
        <p class="welcome-disclaimer">本測驗為個人興趣製作，僅供自我反思之用，非 The Myers-Briggs Company 之官方 MBTI® 測驗，亦非任何專業心理評估。「MBTI」為 The Myers-Briggs Company 之註冊商標。</p>
      </div>
    </div>
  `;
  document.getElementById('start-btn').addEventListener('click', () => {
    state.stage = 'quiz';
    state.currentQ = 0;
    state.answers = {};
    render();
  });
}

function renderQuiz() {
  const i = state.currentQ;
  const q = questions[i];
  const progress = ((i + 1) / questions.length) * 100;
  const dim = dimensionLabels[q.dim];

  app.innerHTML = `
    <div class="quiz">
      <div class="quiz-top">
        <div class="quiz-top-row">
          <button class="back-btn" id="back-btn" ${i === 0 ? 'disabled' : ''}>
            ${arrowLeftSvg}<span>BACK</span>
          </button>
          <div class="quiz-meta">
            <span class="dim">${dim.left} / ${dim.right}</span>
            <span class="dot">·</span>
            <span class="count">${String(i + 1).padStart(2, '0')} / ${questions.length}</span>
          </div>
        </div>
        <div class="progress">
          <div class="progress-fill" style="width: ${progress}%"></div>
        </div>
      </div>

      <div class="quiz-body">
        <div class="quiz-content">
          <div class="quiz-eyebrow">QUESTION ${String(i + 1).padStart(2, '0')}</div>
          <h2 class="quiz-question">${esc(q.q)}</h2>
          <div class="options">
            <button class="option" data-letter="${q.aL}">
              <span class="option-letter">A</span>
              <span class="option-text">${esc(q.a)}</span>
            </button>
            <button class="option" data-letter="${q.bL}">
              <span class="option-letter">B</span>
              <span class="option-text">${esc(q.b)}</span>
            </button>
          </div>
        </div>
      </div>

      <div class="quiz-foot">沒有對錯 · 選擇最接近你的那一個</div>
    </div>
  `;

  document.querySelectorAll('.option').forEach(btn => {
    btn.addEventListener('click', () => handleAnswer(btn.dataset.letter));
  });
  document.getElementById('back-btn').addEventListener('click', handleBack);
}

function handleAnswer(letter) {
  state.answers[state.currentQ] = letter;
  if (state.currentQ < questions.length - 1) {
    state.currentQ++;
    render();
  } else {
    state.stage = 'results';
    render();
  }
}

function handleBack() {
  if (state.currentQ > 0) {
    state.currentQ--;
    render();
  }
}

function calculateType() {
  const counts = { E:0, I:0, S:0, N:0, T:0, F:0, J:0, P:0, A:0, O:0, H:0, C:0 };
  Object.values(state.answers).forEach(l => { counts[l]++; });
  const type =
    (counts.E >= counts.I ? 'E' : 'I') +
    (counts.S >= counts.N ? 'S' : 'N') +
    (counts.T >= counts.F ? 'T' : 'F') +
    (counts.J >= counts.P ? 'J' : 'P');
  const ao = counts.A >= counts.O ? 'A' : 'O';
  const hc = counts.H >= counts.C ? 'H' : 'C';
  return { type, counts, ao, hc };
}

function renderResults() {
  const { type, counts, ao, hc } = calculateType();
  const info = typeInfo[type];
  const stack = cognitiveStacks[type];

  function pct(dim) {
    const { left, right } = dimensionLabels[dim];
    const total = counts[left] + counts[right];
    const leftPct = total ? Math.round((counts[left] / total) * 100) : 50;
    const rightPct = total ? 100 - leftPct : 50;
    const dominant = counts[left] >= counts[right] ? left : right;
    return { leftPct, rightPct, dominant };
  }

  // 4 主要維度的 row
  const mainDimRows = ['EI','SN','TF','JP'].map(dim => {
    const d = dimensionLabels[dim];
    const p = pct(dim);
    const leftActive = p.dominant === d.left;
    const rightActive = p.dominant === d.right;
    const fillHtml = leftActive
      ? `<div class="dim-fill-left" style="width: ${p.leftPct}%"></div>`
      : `<div class="dim-fill-right" style="width: ${p.rightPct}%"></div>`;
    return `
      <div class="dim-row">
        <div class="dim-labels">
          <div class="side">
            <span class="dim-letter ${leftActive ? 'active' : ''}">${d.left}</span>
            <span class="dim-name ${leftActive ? 'active' : ''}">${d.leftName}</span>
            <span class="dim-pct">${p.leftPct}%</span>
          </div>
          <div class="side">
            <span class="dim-pct">${p.rightPct}%</span>
            <span class="dim-name ${rightActive ? 'active' : ''}">${d.rightName}</span>
            <span class="dim-letter ${rightActive ? 'active' : ''}">${d.right}</span>
          </div>
        </div>
        <div class="dim-bar">${fillHtml}<div class="dim-center"></div></div>
      </div>
    `;
  }).join('');

  // A/O、H/C 區塊
  function identityBlock(dim, dominant) {
    const d = dimensionLabels[dim];
    const p = pct(dim);
    const dominantPct = dominant === d.left ? p.leftPct : p.rightPct;
    const insight = identityInsights[dominant];
    return `
      <div class="identity-block">
        <div class="identity-head">
          <span class="identity-name">${d.left} / ${d.right} · ${d.leftName} / ${d.rightName}</span>
          <span class="identity-pct">${dominantPct}% ${dominant}</span>
        </div>
        <div class="identity-title">${esc(insight.name)}</div>
        <div class="identity-desc">${esc(insight.desc)}</div>
      </div>
    `;
  }

  // 八維 list
  const funcRowsHtml = stack.map((code, idx) => {
    const fi = functionInfo[code];
    const isShadow = idx >= 4;
    const dividerHtml = idx === 4
      ? `<div class="func-divider">SHADOW · 陰影面</div>`
      : '';
    return dividerHtml + `
      <div class="func-row ${isShadow ? 'shadow' : ''}">
        <div class="func-rank">${idx + 1}</div>
        <div class="func-code">${code}</div>
        <div class="func-body">
          <div class="func-line">
            <span class="func-name">${esc(fi.name)}</span>
            <span class="func-pos">${esc(positionLabels[idx])}</span>
          </div>
          <div class="func-desc">${esc(fi.desc)}</div>
        </div>
      </div>
    `;
  }).join('');

  app.innerHTML = `
    <div class="results">
      <div class="results-inner">
        <div class="results-eyebrow">
          <div class="label">YOUR TYPE · 你的人格類型</div>
          <div class="row">
            <div class="hairline line"></div>
            <div class="num">nº${type}</div>
            <div class="hairline line"></div>
          </div>
        </div>

        <div class="type-card">
          <div class="type-seal">印</div>
          <div class="type-code">${type}</div>
          <div class="type-suffix">· ${ao} · ${hc} ·</div>
          <div class="type-name">${esc(info.name)}</div>
          <div class="type-tagline">${esc(info.tagline)}</div>
        </div>

        <p class="type-desc">${esc(info.desc)}</p>

        <div class="section">
          <div class="section-label">DIMENSION BREAKDOWN</div>
          <div class="section-zh">四個主要維度</div>
          <div class="breakdown-rows">${mainDimRows}</div>
        </div>

        <div class="section">
          <div class="section-label">IDENTITY DIMENSIONS</div>
          <div class="section-zh">身份維度</div>
          ${identityBlock('AO', ao)}
          ${identityBlock('HC', hc)}
        </div>

        <div class="section">
          <div class="section-label">COGNITIVE FUNCTIONS</div>
          <div class="section-zh">榮格八維 · 功能堆疊</div>
          <div class="functions-grid">${funcRowsHtml}</div>
        </div>

        <div class="restart-wrap">
          <button class="btn-secondary" id="restart-btn">
            ${rotateSvg}<span>RETAKE · 再測一次</span>
          </button>
        </div>

        <div class="results-fin">
          <div class="hairline line"></div>
          <span class="label">fin</span>
          <div class="hairline line"></div>
        </div>
      </div>
    </div>
  `;

  document.getElementById('restart-btn').addEventListener('click', () => {
    state.stage = 'welcome';
    state.currentQ = 0;
    state.answers = {};
    render();
  });
}

render();
</script>
</body>
</html>
