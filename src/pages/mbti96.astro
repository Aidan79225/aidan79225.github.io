<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MBTI · 認識你自己</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style is:global>
  :root {
    --bg: #f3ede1;
    --ink: #1c1814;
    --muted: #6b5f4e;
    --accent: #8b2e2e;
    --card: #faf5e9;
    --border: #d9ccb4;
    --shadow-tone: #b39c7d;
    --serif: "Noto Serif TC", "Source Han Serif TC", "Songti TC", serif;
    --display: "Cormorant Garamond", "Noto Serif TC", serif;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--serif);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    min-height: 100vh;
    position: relative;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: 0.3;
    z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3' stitchTiles='stitch'/%3E%3CfeColorMatrix values='0 0 0 0 0.11 0 0 0 0 0.09 0 0 0 0 0.08 0 0 0 0.08 0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  #app {
    position: relative;
    z-index: 1;
    min-height: 100vh;
  }

  button {
    border: none;
    background: none;
    cursor: pointer;
    font-family: inherit;
    color: inherit;
  }

  .hairline {
    height: 1px;
    background: var(--ink);
    opacity: 0.3;
  }

  /* ─── 歡迎頁 ─── */
  .welcome {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    background-image:
      radial-gradient(ellipse at top, rgba(139, 46, 46, 0.04), transparent 60%),
      radial-gradient(ellipse at bottom, rgba(28, 24, 20, 0.03), transparent 50%);
  }
  .welcome-inner {
    max-width: 28rem;
    width: 100%;
    text-align: center;
  }
  .welcome-since {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 32px;
  }
  .welcome-since .line { width: 48px; }
  .welcome-since .label {
    margin: 0 12px;
    font-family: var(--display);
    font-style: italic;
    color: var(--accent);
    font-size: 12px;
    letter-spacing: 0.2em;
  }
  .welcome-eyebrow {
    font-size: 13px;
    letter-spacing: 0.4em;
    color: var(--muted);
    font-family: var(--display);
    margin-bottom: 16px;
  }
  .welcome-title {
    font-size: 48px;
    line-height: 1.15;
    margin-bottom: 24px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .welcome-title em {
    color: var(--accent);
    font-style: italic;
    font-family: var(--display);
    font-weight: 400;
  }
  .welcome-sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted);
    font-weight: 300;
    margin-bottom: 4px;
  }
  .welcome-sub.small {
    font-size: 14px;
    margin-bottom: 48px;
  }
  .btn-primary {
    padding: 16px 40px;
    font-size: 13px;
    letter-spacing: 0.3em;
    background: var(--ink);
    color: var(--bg);
    font-family: var(--display);
    transition: transform 0.2s, opacity 0.2s;
  }
  .btn-primary:active { transform: scale(0.95); }
  .btn-primary:hover { opacity: 0.9; }
  .welcome-dims {
    margin-top: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 11px;
    color: var(--muted);
    flex-wrap: wrap;
  }
  .welcome-dims em {
    font-family: var(--display);
    font-style: italic;
  }
  .welcome-disclaimer {
    margin: 40px auto 0;
    max-width: 22rem;
    font-size: 11px;
    line-height: 1.7;
    color: var(--muted);
    opacity: 0.75;
  }

  /* ─── 問題頁 ─── */
  .quiz {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  .quiz-top {
    padding: 24px 24px 16px;
  }
  .quiz-top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    color: var(--muted);
    font-family: var(--display);
    letter-spacing: 0.2em;
    transition: opacity 0.2s;
  }
  .back-btn:disabled { opacity: 0.3; cursor: default; }
  .back-btn svg { width: 14px; height: 14px; }
  .quiz-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
  }
  .quiz-meta .dim {
    font-family: var(--display);
    color: var(--accent);
    font-style: italic;
    letter-spacing: 0.1em;
  }
  .quiz-meta .dot { color: var(--muted); }
  .quiz-meta .count {
    font-family: var(--display);
    color: var(--muted);
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
  }
  .progress {
    height: 1px;
    background: var(--border);
    width: 100%;
    position: relative;
  }
  .progress-fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    background: var(--ink);
    transition: width 0.5s ease-out;
  }
  .quiz-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 32px 24px;
  }
  .quiz-content {
    max-width: 28rem;
    width: 100%;
    margin: 0 auto;
    animation: fadeIn 0.4s ease-out;
  }
  .quiz-eyebrow {
    font-size: 12px;
    letter-spacing: 0.3em;
    margin-bottom: 16px;
    text-align: center;
    color: var(--muted);
    font-family: var(--display);
  }
  .quiz-question {
    font-size: 24px;
    line-height: 1.7;
    text-align: center;
    margin-bottom: 40px;
    padding: 0 8px;
    font-weight: 400;
  }
  .options {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .option {
    width: 100%;
    padding: 20px;
    text-align: left;
    background: var(--card);
    border: 1px solid var(--border);
    transition: transform 0.2s, box-shadow 0.2s;
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .option:active { transform: scale(0.98); }
  .option:hover { box-shadow: 0 1px 4px rgba(0,0,0,0.04); }
  .option-letter {
    font-size: 20px;
    font-family: var(--display);
    color: var(--accent);
    font-style: italic;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .option-text {
    font-size: 16px;
    line-height: 1.65;
    font-weight: 400;
  }
  .quiz-foot {
    text-align: center;
    padding: 0 24px 24px;
    font-size: 12px;
    color: var(--muted);
    font-style: italic;
  }

  /* ─── 結果頁 ─── */
  .results {
    padding: 40px 24px 56px;
    background-image: radial-gradient(ellipse at top, rgba(139, 46, 46, 0.06), transparent 60%);
    animation: fadeInUp 0.8s ease-out;
  }
  .results-inner {
    max-width: 28rem;
    margin: 0 auto;
  }
  .results-eyebrow {
    text-align: center;
    margin-bottom: 24px;
  }
  .results-eyebrow .label {
    font-size: 12px;
    letter-spacing: 0.4em;
    color: var(--muted);
    font-family: var(--display);
    margin-bottom: 8px;
  }
  .results-eyebrow .row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .results-eyebrow .row .line { width: 32px; }
  .results-eyebrow .row .num {
    font-size: 12px;
    letter-spacing: 0.2em;
    font-family: var(--display);
    font-style: italic;
    color: var(--accent);
  }
  .type-card {
    text-align: center;
    padding: 32px 24px;
    margin-bottom: 24px;
    background: var(--card);
    border: 1px solid var(--border);
    position: relative;
  }
  .type-seal {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    letter-spacing: 0.15em;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    font-family: var(--display);
    transform: rotate(3deg);
  }
  .type-code {
    font-size: 64px;
    margin-bottom: 4px;
    letter-spacing: 0.05em;
    font-family: var(--display);
    font-weight: 500;
    line-height: 1;
  }
  .type-suffix {
    font-size: 14px;
    color: var(--muted);
    font-family: var(--display);
    letter-spacing: 0.3em;
    margin-bottom: 16px;
    font-style: italic;
  }
  .type-name {
    font-size: 30px;
    font-weight: 500;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .type-tagline {
    font-size: 14px;
    color: var(--muted);
    font-family: var(--display);
    font-style: italic;
    padding: 0 24px;
    line-height: 1.6;
  }
  .type-desc {
    font-size: 16px;
    line-height: 1.9;
    margin-bottom: 32px;
    padding: 0 8px;
  }

  /* 區段標題 */
  .section-label {
    font-size: 12px;
    letter-spacing: 0.3em;
    text-align: center;
    color: var(--muted);
    font-family: var(--display);
    margin-bottom: 8px;
  }
  .section-zh {
    font-size: 13px;
    text-align: center;
    color: var(--muted);
    margin-bottom: 20px;
    font-style: italic;
    font-family: var(--display);
  }
  .section {
    margin-bottom: 40px;
  }

  /* 條形圖 */
  .breakdown-rows {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .dim-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .dim-labels {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .dim-labels .side {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 13px;
  }
  .dim-letter {
    font-size: 18px;
    font-family: var(--display);
    color: var(--muted);
  }
  .dim-letter.active {
    font-weight: 600;
    color: var(--accent);
  }
  .dim-name {
    font-size: 12px;
    color: var(--muted);
  }
  .dim-name.active { color: var(--ink); }
  .dim-pct {
    font-size: 12px;
    color: var(--muted);
    font-family: var(--display);
    font-variant-numeric: tabular-nums;
  }
  .dim-bar {
    position: relative;
    height: 2px;
    background: var(--border);
  }
  .dim-fill-left {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    background: var(--accent);
    transition: width 1s ease-out;
  }
  .dim-fill-right {
    position: absolute;
    right: 0; top: 0; bottom: 0;
    background: var(--accent);
    transition: width 1s ease-out;
  }
  .dim-center {
    position: absolute;
    top: -3px;
    left: 50%;
    width: 1px;
    height: 8px;
    background: var(--ink);
    opacity: 0.4;
    transform: translateX(-0.5px);
  }

  /* 身份維度區塊 (A/O, H/C) */
  .identity-block {
    background: var(--card);
    border: 1px solid var(--border);
    padding: 20px 24px;
    margin-bottom: 16px;
  }
  .identity-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
  }
  .identity-name {
    font-size: 13px;
    color: var(--muted);
    font-family: var(--display);
    letter-spacing: 0.15em;
  }
  .identity-pct {
    font-size: 13px;
    color: var(--accent);
    font-family: var(--display);
    font-variant-numeric: tabular-nums;
    font-style: italic;
  }
  .identity-title {
    font-size: 18px;
    color: var(--accent);
    margin-bottom: 8px;
    font-weight: 500;
  }
  .identity-desc {
    font-size: 14px;
    line-height: 1.85;
    color: var(--ink);
  }

  /* 八維 */
  .functions-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
    background: var(--card);
    border: 1px solid var(--border);
  }
  .func-row {
    display: flex;
    align-items: flex-start;
    padding: 14px 18px;
    border-bottom: 1px dashed var(--border);
    gap: 14px;
  }
  .func-row:last-child { border-bottom: none; }
  .func-row.shadow {
    opacity: 0.55;
  }
  .func-rank {
    flex-shrink: 0;
    width: 24px;
    text-align: center;
    font-family: var(--display);
    font-style: italic;
    color: var(--muted);
    font-size: 14px;
    padding-top: 2px;
  }
  .func-code {
    flex-shrink: 0;
    width: 32px;
    font-size: 22px;
    font-family: var(--display);
    font-weight: 600;
    color: var(--accent);
    line-height: 1.1;
  }
  .func-row.shadow .func-code { color: var(--muted); }
  .func-body {
    flex: 1;
    min-width: 0;
  }
  .func-line {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 4px;
  }
  .func-name {
    font-size: 14px;
    font-weight: 500;
  }
  .func-pos {
    font-size: 11px;
    color: var(--muted);
    font-family: var(--display);
    font-style: italic;
  }
  .func-desc {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.6;
  }
  .func-divider {
    padding: 8px 18px;
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--muted);
    font-family: var(--display);
    background: var(--bg);
    border-top: 1px dashed var(--border);
    border-bottom: 1px dashed var(--border);
    text-align: center;
    font-style: italic;
  }

  .restart-wrap { text-align: center; margin-top: 8px; }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 32px;
    font-size: 12px;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--display);
    letter-spacing: 0.3em;
    transition: transform 0.2s, background 0.2s, color 0.2s;
  }
  .btn-secondary:active { transform: scale(0.95); }
  .btn-secondary:hover { background: var(--ink); color: var(--bg); }
  .btn-secondary svg { width: 12px; height: 12px; }
  .results-fin {
    margin-top: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }
  .results-fin .line {
    width: 40px;
    opacity: 0.2;
  }
  .results-fin .label {
    font-size: 10px;
    letter-spacing: 0.3em;
    color: var(--muted);
    font-family: var(--display);
    font-style: italic;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 640px) {
    .welcome-title { font-size: 56px; }
    .quiz-question { font-size: 26px; }
    .type-code { font-size: 76px; }
  }
</style>
</head>
<body>
<div id="app"></div>

<script is:inline>
// ═══════════ 題目（96） ═══════════
const questions = [
  // ─── E / I (16) ───
  { q: "參加大型聚會時，你比較像是⋯⋯", a: "主動走向陌生人搭話", b: "先觀察環境再決定互動", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "連續幾天的社交活動後，你會⋯⋯", a: "感覺精力充沛、想繼續", b: "需要一個人待著充電", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "遇到問題時，你傾向⋯⋯", a: "邊說邊想、討論出答案", b: "先在心裡想清楚再開口", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "理想的工作環境是⋯⋯", a: "開放、有人討論的空間", b: "安靜、能獨立專注的角落", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "剛認識的朋友，通常覺得你⋯⋯", a: "熱情、容易親近", b: "有點內斂、需要時間熟悉", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "空檔的週末，你更想⋯⋯", a: "約幾個朋友出去", b: "一個人在家做喜歡的事", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "會議/課堂中你通常⋯⋯", a: "會主動發言、提出想法", b: "聽到有把握的點才說", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "電話突然響起時，你的第一反應是⋯⋯", a: "直接接起來", b: "猶豫一下看要不要接", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "你的交友圈比較像⋯⋯", a: "廣泛、各領域都有", b: "少數幾個但很深", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "面對一整天的獨處，你會⋯⋯", a: "覺得有點悶，想找人", b: "感覺平靜、很享受", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "表達想法時，你通常⋯⋯", a: "一邊說一邊整理思路", b: "想清楚結構後才講出來", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "你的能量來源比較是⋯⋯", a: "和人互動、外部刺激", b: "獨處與內在沉澱", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "學習新東西時，你偏好⋯⋯", a: "找人一起討論、交流", b: "自己研究、慢慢鑽研", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "被介紹給一群新朋友，你⋯⋯", a: "自然地加入聊天", b: "先站旁邊觀察氣氛", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "面對一個機會時，你傾向⋯⋯", a: "先行動、邊做邊調整", b: "先想清楚再決定", dim: 'EI', aL: 'E', bL: 'I' },
  { q: "你覺得自己比較⋯⋯", a: "外放、表達自如", b: "內向、心思細膩", dim: 'EI', aL: 'E', bL: 'I' },

  // ─── S / N (16) ───
  { q: "描述一件事情，你會⋯⋯", a: "講具體細節、時間地點", b: "講整體印象、意義感受", dim: 'SN', aL: 'S', bL: 'N' },
  { q: "你比較相信⋯⋯", a: "親身經驗與事實", b: "直覺與可能性", dim: 'SN', aL: 'S', bL: 'N' },
  { q: "閱讀時你偏好⋯⋯", a: "實用、具體的內容", b: "抽象、理論、想像力", dim: 'SN', aL: 'S', bL: 'N' },
  { q: "面對新任務，你傾向⋯⋯", a: "參考現有做法", b: "想一套自己的新方法", dim: 'SN', aL: 'S', bL: 'N' },
  { q: "你的注意力較常放在⋯⋯", a: "當下的實際狀況", b: "未來的可能與趨勢", dim: 'SN', aL: 'S', bL: 'N' },
