---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, byDateDesc } from '../../lib/posts';
import { countTags, pageTags } from '../../lib/tags.mjs';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  // 只有一篇的 tag 不產生頁面 —— 點進去就是讀者剛看完的那一篇,對導覽沒有
  // 價值,對搜尋引擎是 thin content。tag 本身仍留在文章上,只是不做成連結。
  const tags = pageTags(countTags(posts)).map(([tag]) => tag);
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => (p.data.tags ?? []).includes(tag))
        .sort(byDateDesc),
    },
  }));
}

const { tag, posts } = Astro.props;
---
<BaseLayout title={`#${tag}`}>
  <h1 class="text-2xl font-bold mb-4">#{tag}</h1>
  <div class="space-y-4">
    {posts.map((p) => <PostCard post={p} />)}
  </div>
</BaseLayout>
