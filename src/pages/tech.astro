---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, byDateDesc } from '../lib/posts';
const posts = (await getPublishedPosts())
  .filter((p) => p.data.category === 'tech')
  .sort(byDateDesc);
---
<BaseLayout title="Tech" description="技術文章 —— 資料工程與後端:Airflow、Spark、Kafka、dbt、資料架構與技術領導,用圖像把複雜概念講清楚。">
  <h1 class="text-2xl font-bold mb-4">Tech</h1>
  <div class="space-y-4">
    {posts.map((p) => <PostCard post={p} />)}
  </div>
</BaseLayout>
