---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getPublishedPosts } from '../../lib/posts';
import { sortBySeriesOrder } from '../../lib/series-order.mjs';

// 小說連載。和 /tech/ 一樣每頁 20 篇,但章節照系列順序排(第一章在最上面),
// 不是最新的在最上面 —— 規則見 src/lib/series-order.mjs。
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = sortBySeriesOrder(
    (await getPublishedPosts()).filter((p) => p.data.category === 'fiction'),
  );
  return paginate(posts, { pageSize: 20 });
};

const { page } = Astro.props;
---
<BaseLayout
  title={page.currentPage === 1 ? '小說' : `小說(第 ${page.currentPage} 頁)`}
  description="小說連載 —— 原創長篇《霧港白露》:架空 1930 年代的南方港埠,《節制令》之下的私酒、海關與人。章節照順序排列,從第一章讀起。"
>
  <h1 class="text-2xl font-bold mb-4">小說</h1>
  <div class="space-y-4">
    {page.data.map((p) => <PostCard post={p} />)}
  </div>
  <Pagination page={page} />
</BaseLayout>
