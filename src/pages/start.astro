---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/posts';

const all = await getPublishedPosts();
const byId = new Map(all.map((p) => [p.id, p]));
const bySeries = (name: string) =>
  all
    .filter((p) => p.data.series === name)
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
const pick = (ids: string[]) => ids.map((id) => byId.get(id)).filter(Boolean);

// Series keys. Series-based blocks stay fresh automatically as new entries land.
const series = {
  fode: 'Fundamentals of Data Engineering 讀書筆記',
  sql: 'SQL 我以為我懂',
  ddia: 'Designing Data-Intensive Applications 讀書筆記',
  spark: 'Spark 學習筆記',
  kafka: 'Kafka 學習筆記',
  airflow: 'Airflow 學習筆記',
  redis: 'Redis 學習筆記',
  k8s: 'Kubernetes 學習筆記',
  infra: '從 Infra 角度看資料工具',
  sre: 'Google SRE 讀書筆記',
  obs: 'Grafana LGTM 可觀測性',
  btl: '成為 Tech Leader 讀書筆記',
};

// Organised like Clean Architecture: inner layers (概念) are stable & portable,
// outer layers (工具) are concrete & replaceable. Dependencies point inward.
const layers = [
  {
    tag: '核心 · Domain',
    color: '#54b890',
    title: '核心觀念:最穩、最能遷移的一層',
    blurb:
      '這一層是換幾份工作都還在用的東西——查詢語言、資料工程的心智地圖、資料密集系統的原理。工具會被替換,這些不會。先把這裡打牢,再往外走。',
    groups: [
      { heading: series.fode, posts: bySeries(series.fode) },
      { heading: series.sql, posts: bySeries(series.sql) },
      { heading: series.ddia, posts: bySeries(series.ddia) },
    ],
  },
  {
    tag: '應用與架構 · Application',
    color: '#4f6df5',
    title: '轉換與架構:把觀念組織成系統',
    blurb:
      '介於觀念與工具之間的一層——怎麼把原始資料煉成可用模型、怎麼安排轉換與分層,以及幾個我認為最該懂的架構觀念。',
    groups: [
      { heading: null, posts: pick(['dbt-intro', 'medallion-architecture', 'pain-before-power']) },
    ],
  },
  {
    tag: '基礎設施 · Infrastructure',
    color: '#d6a45c',
    title: '基礎設施:落地觀念的具體工具',
    blurb:
      '最外層、最具體、也最會被替換的一層。這些工具各自把上面的觀念變成能跑的東西——但它們是「手段」,核心觀念才是「目的」。看工具時,常回頭想它在實作哪個觀念。',
    groups: [
      { heading: '記憶體資料結構 · ' + series.redis, posts: bySeries(series.redis) },
      { heading: '事件串流 · ' + series.kafka, posts: bySeries(series.kafka) },
      { heading: '分散式運算 · ' + series.spark, posts: bySeries(series.spark) },
      { heading: '工作流程編排 · ' + series.airflow, posts: bySeries(series.airflow) },
      { heading: '容器編排 · ' + series.k8s, posts: bySeries(series.k8s) },
      { heading: '分散式協調 · 單篇', posts: pick(['zookeeper']) },
      { heading: '橫向視角:把工具當 infra 養(維運 / 部署 / 平台)· ' + series.infra, posts: bySeries(series.infra) },
    ],
  },
  {
    tag: '橫切 · Cross-cutting',
    color: '#e05a7d',
    title: '可靠度與可觀測性:貫穿每一層',
    blurb:
      '這一層橫切全部——資料要正確、服務要不掛、變更要安全,而這一切的前提是「看得見」。SRE 講的是可靠度的觀念與文化(為什麼);Grafana LGTM 這套可觀測性工具講的是怎麼把它變成真的儀表板、告警與 SLO(怎麼做)。這也是我現在身兼 DE team EM 與 SRE、最花心力的一塊。',
    groups: [
      { heading: '可靠度的觀念與文化 · ' + series.sre, posts: bySeries(series.sre) },
      { heading: '可觀測性工具:LGTM 全家桶 · ' + series.obs, posts: bySeries(series.obs) },
    ],
  },
  {
    tag: '技術之外 · Beyond',
    color: '#9aa4b2',
    title: '人與成長:技術領導',
    blurb: '技術之外的另一條線——讀《成為 Tech Leader》的筆記與反思,寫給正在或即將帶人的工程師。',
    groups: [{ heading: series.btl, posts: bySeries(series.btl) }],
  },
];
---
<BaseLayout
  title="Start Here"
  description="從這裡開始 —— 借用 Clean Architecture 的分層來組織這個部落格:核心觀念(SQL、資料工程、DDIA)在內、最穩定;基礎設施工具(Redis、Kafka、Spark、Airflow、Kubernetes,以及從 infra 角度看它們)在外、最具體;SRE 可靠度與 Grafana LGTM 可觀測性橫切每一層,技術領導在技術之外。"
>
  <h1 class="text-3xl font-bold mb-2">從這裡開始</h1>
  <p class="text-muted mb-6">
    這裡的文章多半用一張圖 + 精簡的文字,把複雜的東西講清楚。我把它們借用 <strong class="text-ink">Clean Architecture</strong> 的分層來組織——<strong class="text-ink">越靠核心越穩定、越能遷移(觀念);越往外越具體、越會被替換(工具)</strong>。依賴指向核心、學習也一樣:先把內圈的觀念打牢,再往外學會被換掉的工具。
  </p>

  <figure class="my-6 flex justify-center">
    <svg viewBox="0 0 600 350" role="img" aria-label="用 Clean Architecture 的同心圓組織這個部落格。最內圈是核心觀念 Domain,含 SQL、資料工程、DDIA,最穩定最能遷移。中間圈是應用與架構 Application,如 dbt、Medallion。最外圈是基礎設施 Infrastructure,含 Redis、Kafka、Spark、Airflow、Kubernetes,最具體最會被替換。依賴方向由外指向內,外層依賴內層、內層不依賴外層;外層工具會被替換,內層觀念要穩定。學習順序先核心觀念再具體工具。SRE 可靠度橫切每一層,Tech Leader 在技術之外。" style="width:100%;max-width:600px;height:auto;">
      <circle cx="180" cy="168" r="150" fill="#1f2330" stroke="#d6a45c" stroke-width="1.6"/>
      <circle cx="180" cy="168" r="100" fill="#232838" stroke="#4f6df5" stroke-width="1.6"/>
      <circle cx="180" cy="168" r="50" fill="#223528" stroke="#54b890" stroke-width="1.8"/>
      <text x="180" y="40" fill="#d6a45c" font-size="12" text-anchor="middle" font-weight="bold">基礎設施</text>
      <text x="180" y="54" fill="#9aa4b2" font-size="8" text-anchor="middle">Infrastructure</text>
      <text x="180" y="92" fill="#4f6df5" font-size="11" text-anchor="middle" font-weight="bold">應用與架構</text>
      <text x="180" y="105" fill="#9aa4b2" font-size="7.6" text-anchor="middle">Application</text>
      <text x="180" y="162" fill="#54b890" font-size="11" text-anchor="middle" font-weight="bold">核心觀念</text>
      <text x="180" y="175" fill="#9aa4b2" font-size="7.4" text-anchor="middle">Domain</text>
      <text x="180" y="190" fill="#7fbfa0" font-size="7" text-anchor="middle">SQL · FoDE · DDIA</text>
      <text x="180" y="250" fill="#8aa0e6" font-size="7.4" text-anchor="middle">dbt · Medallion</text>
      <text x="180" y="300" fill="#d6b98a" font-size="7.6" text-anchor="middle">Redis · Kafka · Spark · Airflow · K8s</text>
      <defs><marker id="dep" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="#9aa4b2"/></marker></defs>
      <line x1="575" y1="70" x2="392" y2="70" stroke="#9aa4b2" stroke-width="1.4" marker-end="url(#dep)"/>
      <text x="483" y="62" fill="#e6e6e6" font-size="9" text-anchor="middle" font-weight="bold">依賴方向:外 → 內</text>
      <text x="392" y="112" fill="#9aa4b2" font-size="8.6" text-anchor="start">外層依賴內層,</text>
      <text x="392" y="127" fill="#9aa4b2" font-size="8.6" text-anchor="start">內層不依賴外層。</text>
      <text x="392" y="152" fill="#9aa4b2" font-size="8.6" text-anchor="start">外層(工具)會被替換,</text>
      <text x="392" y="167" fill="#9aa4b2" font-size="8.6" text-anchor="start">內層(觀念)要穩定。</text>
      <text x="392" y="196" fill="#54b890" font-size="8.8" text-anchor="start" font-weight="bold">學習順序:</text>
      <text x="392" y="210" fill="#54b890" font-size="8.8" text-anchor="start" font-weight="bold">先核心觀念,再具體工具</text>
      <rect x="392" y="232" width="185" height="30" rx="6" fill="#3a2632" stroke="#e05a7d" stroke-width="1.3"/>
      <text x="404" y="248" fill="#e05a7d" font-size="8.6" text-anchor="start" font-weight="bold">SRE + LGTM 可觀測性</text>
      <text x="404" y="258" fill="#9aa4b2" font-size="7.4" text-anchor="start">可靠度與觀測橫切每一層</text>
      <rect x="392" y="268" width="185" height="30" rx="6" fill="#262b3a" stroke="#9aa4b2" stroke-width="1.2"/>
      <text x="404" y="287" fill="#e6e6e6" font-size="8.6" text-anchor="start">Tech Leader — 技術之外</text>
    </svg>
  </figure>

  <div class="space-y-6">
    {layers.map((layer) => (
      <section class="bg-surface border border-line rounded-lg p-5" style={`border-left:3px solid ${layer.color}`}>
        <span
          class="inline-block text-[11px] font-mono font-bold mb-2 px-2 py-0.5 rounded"
          style={`color:${layer.color};border:1px solid ${layer.color}`}
        >{layer.tag}</span>
        <h2 class="text-xl font-bold mb-1">{layer.title}</h2>
        <p class="text-muted text-sm mb-4">{layer.blurb}</p>
        <div class="space-y-4">
          {layer.groups.map((g) => (
            <div>
              {g.heading && <p class="text-xs text-muted mb-2">📚 {g.heading}</p>}
              <ol class="list-none m-0 p-0 space-y-1.5">
                {g.posts.map((p, i) => (
                  <li class="flex gap-3">
                    <span class="text-accent text-sm font-mono shrink-0 w-5 text-right">{i + 1}</span>
                    <a href={`/blog/${p.id}/`} class="text-ink hover:text-accent no-underline text-sm leading-relaxed">
                      {p.data.title}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>

  <p class="text-muted text-sm mt-8">
    想找特定主題?用右上角的搜尋,或到 <a href="/tags/" class="text-accent hover:underline">標籤頁</a> 依主題瀏覽。
  </p>
</BaseLayout>
