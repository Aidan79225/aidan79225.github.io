---
import { render } from 'astro:content';
import { getPublishedPosts } from '../../../lib/posts';
import { localizeHtml } from '../../../lib/i18n';
import PostLayout from '../../../layouts/PostLayout.astro';

// Every post exists at /en/blog/<slug>/: the English translation when one is
// published (collection id `en/<slug>` → URL param without the prefix), and
// otherwise the zh original as a fallback — so /en/ navigation never 404s.
// Fallback pages render as Chinese content (PostLayout keeps zh strings) and
// BaseLayout marks them canonical → /blog/<slug>/ with a notice bar.
export async function getStaticPaths() {
  const enPosts = await getPublishedPosts('en');
  const translated = new Set(enPosts.map((p) => p.data.translationOf).filter(Boolean));
  const zhFallbacks = (await getPublishedPosts()).filter((p) => !translated.has(p.id));
  return [
    ...enPosts.map((post) => ({
      params: { slug: post.id.replace(/^en\//, '') },
      props: { post },
    })),
    ...zhFallbacks.map((post) => ({
      params: { slug: post.id },
      props: { post },
    })),
  ];
}

const { post } = Astro.props;
// Post bodies are rendered once and shared across locales, so in-body links
// (wiki-links, markdown links) point at unprefixed zh URLs. Rewrite the
// rendered HTML so article-to-article jumps stay inside /en/ — for real
// translations and zh fallbacks alike.
const { headings } = await render(post);
const html = localizeHtml(post.rendered?.html ?? '');
---
<PostLayout post={post} headings={headings}>
  <Fragment set:html={html} />
</PostLayout>
