---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPublishedPosts, byDateDesc } from '../../../lib/posts';

// English counterpart of /tech/: every translated tech post, newest first.
// (Without this file /en/tech/ would be the zh list served as a fallback.)
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = (await getPublishedPosts('en'))
    .filter((p) => p.data.category === 'tech')
    .sort(byDateDesc);
  return paginate(posts, { pageSize: 20 });
};

const { page } = Astro.props;
const suffix = page.currentPage === 1 ? '' : `${page.currentPage}/`;
const alternates = [
  { hreflang: 'zh-Hant', href: new URL(`/tech/${suffix}`, Astro.site).href },
  { hreflang: 'en', href: new URL(`/en/tech/${suffix}`, Astro.site).href },
  { hreflang: 'x-default', href: new URL(`/tech/${suffix}`, Astro.site).href },
];
---
<BaseLayout
  title={page.currentPage === 1 ? 'Tech' : `Tech (page ${page.currentPage})`}
  description="Tech posts in English — data engineering and backend: Airflow, Spark, Kafka, dbt, data architecture and tech leadership, with complex ideas explained in diagrams."
  locale="en"
  alternates={alternates}
>
  <h1 class="text-2xl font-bold mb-4">Tech</h1>
  <div class="space-y-4">
    {page.data.map((p) => <PostCard post={p} />)}
  </div>
  <Pagination page={page} />
</BaseLayout>
