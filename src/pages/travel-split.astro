---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/tools.css';
---
<BaseLayout
  title="旅遊分帳"
  description="多人旅遊記帳與分帳工具 —— 平均／權重／指定金額分攤,自動算出最少筆數的還款方案,並可透過 Google Sheet 讓同行成員共享同一份帳。"
>
  <div class="tool-page travel-split">
    <h2>🧳 旅遊分帳</h2>
    <p class="ts-intro">
      記錄一趟旅程裡「誰付了什麼、誰要分攤」,自動算出每個人的結餘與<strong>最少筆數</strong>的還款方案。
      支援<strong>多幣別</strong>:每筆可填原幣金額＋自訂匯率,或直接填台幣;結餘與還款一律換算成<strong>主要幣別(台幣)</strong>。
      資料預設存在本機瀏覽器;設定一個 <strong>Google Apps Script 端點</strong>後,同一組<strong>行程代碼</strong>的成員就能共享同一份帳
      ——各自新增的支出會自動合併,不會互相蓋掉。
    </p>

    <!-- 行程 -->
    <div class="ts-card">
      <div class="ts-row">
        <label class="ts-field ts-grow"><span>行程名稱</span><input type="text" id="tripName" placeholder="例如:2026 沖繩" /></label>
        <label class="ts-field"><span>主要幣別(結算用)</span><input type="text" id="tripCurrency" class="ts-w6" placeholder="TWD" /></label>
        <label class="ts-field"><span>行程代碼(共享用)</span><input type="text" id="tripCode" class="ts-w9" placeholder="okinawa26" /></label>
      </div>
    </div>

    <!-- 成員 -->
    <h3>👥 成員</h3>
    <div class="ts-card">
      <div class="ts-row">
        <input type="text" id="memberName" class="ts-grow" placeholder="輸入名字後按新增" />
        <button id="addMember">＋ 新增成員</button>
      </div>
      <div id="memberList" style="margin-top:.6rem"></div>
      <div class="ts-row" style="margin-top:.7rem; align-items:flex-end">
        <label class="ts-field"><span>我是(這台裝置)</span><select id="meSelect" class="ts-w9"></select></label>
        <span class="ts-muted" id="meHint">選好「我是誰」後,你記的支出只有你自己能改/刪</span>
      </div>
    </div>

    <!-- 記一筆 -->
    <h3>💸 記一筆</h3>
    <div class="ts-card">
      <div class="ts-row">
        <label class="ts-field ts-grow"><span>說明</span><input type="text" id="expDesc" placeholder="例如:午餐、租車" /></label>
        <label class="ts-field"><span>原幣別</span><input type="text" id="expCurrency" class="ts-w6" list="curList" placeholder="TWD" /></label>
        <label class="ts-field"><span id="expAmountLabel">原幣金額</span><input type="number" id="expAmount" class="ts-w9" min="0" step="0.01" /></label>
      </div>
      <div class="ts-row" style="margin-top:.6rem">
        <label class="ts-field"><span>計價幣別</span><input type="text" id="expBaseCur" class="ts-w6" disabled /></label>
        <label class="ts-field"><span id="expBaseAmountLabel">計價金額(刷卡跳出的)</span><input type="number" id="expBaseAmount" class="ts-w9" min="0" step="0.01" /></label>
        <label class="ts-field"><span>匯率(自動,可自填)</span><input type="number" id="expRate" class="ts-w9" min="0" step="0.0001" value="1" /></label>
      </div>
      <datalist id="curList">
        <option value="TWD"></option><option value="JPY"></option><option value="USD"></option>
        <option value="EUR"></option><option value="KRW"></option><option value="THB"></option>
        <option value="CNY"></option><option value="HKD"></option><option value="SGD"></option>
        <option value="GBP"></option><option value="AUD"></option><option value="VND"></option>
        <option value="MYR"></option><option value="PHP"></option><option value="IDR"></option>
      </datalist>
      <p class="ts-muted ts-conv" id="convHint" style="margin:.5rem 0 0"></p>
      <div class="ts-row" style="margin-top:.6rem">
        <label class="ts-field"><span>付款人</span><select id="expPayer" class="ts-w9"></select></label>
        <label class="ts-field"><span>分攤方式</span>
          <select id="expMode" class="ts-w9">
            <option value="even">平均分攤</option>
            <option value="weight">依權重</option>
            <option value="exact">指定金額</option>
          </select>
        </label>
        <label class="ts-field"><span>日期</span><input type="date" id="expDate" class="ts-w9" /></label>
        <label class="ts-field"><span>分類</span><input type="text" id="expCategory" class="ts-w9" placeholder="餐飲/交通…" /></label>
      </div>
      <p class="ts-muted" style="margin:.7rem 0 .2rem" id="splitHint">分攤對象</p>
      <div class="ts-split-list" id="splitList"></div>
      <div class="ts-row" style="margin-top:.6rem">
        <button id="saveExpense">＋ 新增支出</button>
        <button class="ghost" id="cancelEdit" style="display:none;background:#374151">取消編輯</button>
      </div>
    </div>

    <!-- 支出清單 -->
    <h3>🧾 支出清單</h3>
    <div id="expenseList"></div>

    <!-- 結餘 -->
    <h3>📊 結餘</h3>
    <p class="ts-muted">正數 = 別人欠他;負數 = 他要付出。</p>
    <div id="balanceList"></div>

    <!-- 還款 -->
    <h3>🤝 建議還款(最少筆數)</h3>
    <p class="ts-muted">按「已還」把該筆記成還款(金額可改成部分),結餘與建議會即時更新。</p>
    <div id="settleList"></div>

    <!-- 已還款紀錄 -->
    <h3>✅ 已還款紀錄</h3>
    <div id="settlementList"></div>
    <details class="ts-guide" style="margin-top:.6rem">
      <summary>手動新增一筆還款</summary>
      <div class="ts-card">
        <div class="ts-row">
          <label class="ts-field"><span>誰付(from)</span><select id="stFrom" class="ts-w9"></select></label>
          <label class="ts-field"><span>付給誰(to)</span><select id="stTo" class="ts-w9"></select></label>
          <label class="ts-field"><span>金額</span><input type="number" id="stAmount" class="ts-w9" min="0" step="0.01" /></label>
          <label class="ts-field"><span>日期</span><input type="date" id="stDate" class="ts-w9" /></label>
        </div>
        <div class="ts-row" style="margin-top:.6rem">
          <button id="addSettlement">＋ 新增還款</button>
        </div>
      </div>
    </details>

    <!-- 同步 / 共享 -->
    <h3>☁️ 共享(Google Sheet)</h3>
    <div class="ts-card">
      <label class="ts-field" style="width:100%">
        <span>Google Apps Script 端點網址(以 /exec 結尾)</span>
        <input type="text" id="endpoint" placeholder="https://script.google.com/macros/s/……/exec" />
      </label>
      <div class="ts-row" style="margin-top:.6rem">
        <button id="syncBtn">⟲ 同步</button>
        <button id="shareBtn">🔗 複製分享連結</button>
        <button class="ghost" id="exportBtn" style="background:#374151">匯出 JSON</button>
        <button class="ghost" id="importBtn" style="background:#374151">匯入 JSON</button>
        <input type="file" id="importFile" accept="application/json,.json" style="display:none" />
        <button class="ghost" id="resetBtn" style="background:#7f1d1d">清空此行程</button>
      </div>
      <label class="ts-muted" style="display:inline-flex;align-items:center;gap:.4rem;margin-top:.5rem;cursor:pointer">
        <input type="checkbox" id="autoSync" style="width:auto" /> 新增/修改/刪除後自動同步
      </label>
      <p class="ts-muted" style="margin:.5rem 0 0">
        「複製分享連結」會把端點與行程代碼打包進網址,朋友點開即自動帶入並同步,不用手動設定。
        (連結含此帳本的讀寫權限,只傳給同行的人。)
      </p>
      <p class="ts-status ts-muted" id="syncStatus" style="margin-top:.5rem"></p>

      <details class="ts-guide">
        <summary>如何設定 Google Sheet 共享(一次性,約 3 分鐘)</summary>
        <ol>
          <li>開一份新的 <a href="https://sheets.new" target="_blank" rel="noopener">Google 試算表</a>。</li>
          <li>上方選單 <b>擴充功能 → Apps Script</b>。</li>
          <li>把編輯器裡的內容全部刪掉,貼上下面這段程式碼,按 💾 儲存。</li>
          <li>右上角 <b>部署 → 新增部署作業</b>,類型選 <b>網頁應用程式</b>;「執行身分」選<b>我</b>,「誰可以存取」選 <b>任何人</b>,按<b>部署</b>並授權。</li>
          <li>複製產生的<b>網頁應用程式網址</b>(以 <code>/exec</code> 結尾),貼到上面的「端點網址」欄位。</li>
          <li>把同一個<b>行程代碼</b>與這個端點網址告訴同行的人,大家按「同步」就會共用同一份帳。</li>
        </ol>
        <p class="ts-muted">
          每次同步後,試算表會自動多出一個 <b>明細_&lt;行程代碼&gt;</b> 分頁(一列一筆、可讀、可下載成 Excel)——
          它是<b>唯讀鏡像</b>,每次同步會用主資料重建,直接在上面手改不會回寫。
          <br>已在用舊版的人要換這版:到 Apps Script <b>部署 → 管理部署作業 → ✏️ 編輯 → 版本選「新版本」→ 部署</b>,
          這樣<b>網址不變</b>(不要「新增部署作業」,那會產生新網址)。
        </p>
        <p class="ts-muted">資料存在你自己的 Google 帳號裡,本站不經手也不保存任何資料。程式碼:</p>
        <pre id="gasCode"></pre>
        <button id="copyGas" style="margin-top:.4rem">複製程式碼</button>
      </details>
    </div>

    <p class="note ts-muted" style="margin-top:1.5rem">
      ※ 多幣別:填原幣金額後,可直接填<strong>計價金額(刷卡跳出的台幣)</strong>——此時匯率會自動反推,實際結算<strong>以刷卡金額為準</strong>(比手動填匯率準);
      也可只填匯率讓系統換算。計算一律用計價幣別(台幣)基準額;原幣別填台幣時匯率鎖 1,等同直接輸台幣。
      金額以「分」為單位精算,平均分攤的零頭會依成員順序逐分分配,加總必定等於總額。
      共享採「最後修改者勝出」的合併策略:兩人同時各記各的沒問題,但若兩人幾乎同時修改<em>同一筆</em>支出,較晚同步者會覆蓋較早者。
    </p>
  </div>

  <div class="ts-toast" id="undoToast" role="status" aria-live="polite"></div>

  <script>
    import {
      shareOf, computeBalances, settle, totalSpent, mergeTrips, round2,
      toBase, deriveExactBase,
    } from '../lib/travel-split.mjs';

    // ── 狀態與儲存 ──────────────────────────────────────────────
    const LS_ENDPOINT = 'travel-split:endpoint';
    const LS_LAST = 'travel-split:last-code';
    const LS_LASTCUR = 'travel-split:last-currency';
    const LS_LASTRATE = 'travel-split:last-rate';
    const LS_AUTOSYNC = 'travel-split:autosync';
    const tripKey = (code) => `travel-split:trip:${code || '_default'}`;
    const meKey = (code) => `travel-split:me:${code || '_default'}`; // 本機的「我是誰」(依行程代碼)

    let me = ''; // 目前這台裝置對應的成員 id
    const loadMe = (code) => { try { me = localStorage.getItem(meKey(code)) || ''; } catch (_) { me = ''; } };
    const saveMe = () => { try { localStorage.setItem(meKey(trip.code), me); } catch (_) {} };
    // 是否可修改此支出:沒有記錄者(舊資料)→ 任何人可改;否則僅記錄者本人
    const isOwner = (e) => !e || !e.createdBy || e.createdBy === me;

    // 記住上一次填的幣別與匯率,新增下一筆時自動帶入。
    let lastCurrency = '';
    let lastRate = '';
    function rememberCurrency(cur, rate) {
      lastCurrency = cur || '';
      lastRate = rate == null ? '' : String(rate);
      try {
        localStorage.setItem(LS_LASTCUR, lastCurrency);
        localStorage.setItem(LS_LASTRATE, lastRate);
      } catch (_) {}
    }

    // UTF-8-safe base64url(可含中文的行程名稱)。
    const b64urlEncode = (str) =>
      btoa(String.fromCharCode(...new TextEncoder().encode(str)))
        .replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
    const b64urlDecode = (s) => {
      const b64 = s.replace(/-/g, '+').replace(/_/g, '/');
      const bin = atob(b64 + '==='.slice((b64.length + 3) % 4));
      return new TextDecoder().decode(Uint8Array.from(bin, (c) => c.charCodeAt(0)));
    };
    // 把共享設定打包成分享連結的 payload,及反向解析。
    const encodeShare = (obj) => b64urlEncode(JSON.stringify(obj));
    const decodeShare = (s) => JSON.parse(b64urlDecode(s));

    const uid = () =>
      (crypto.randomUUID?.() ||
        `${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}`);
    const now = () => Date.now();

    function emptyTrip(code) {
      return {
        code: code || '',
        name: '',
        currency: 'TWD',
        metaUpdatedAt: 0, // 尚未編輯過 → 合併時不會蓋掉雲端既有的名稱/幣別
        members: [],
        expenses: [],
        settlements: [],
      };
    }

    let trip = null;
    let editingId = null; // 正在編輯的支出 id

    function loadTrip(code) {
      try {
        const raw = localStorage.getItem(tripKey(code));
        if (raw) {
          const t = JSON.parse(raw);
          if (!t.settlements) t.settlements = []; // 舊資料補欄位
          return t;
        }
      } catch (_) {}
      return emptyTrip(code);
    }
    function saveTrip() {
      try {
        localStorage.setItem(tripKey(trip.code), JSON.stringify(trip));
        localStorage.setItem(LS_LAST, trip.code || '');
      } catch (_) {}
    }

    const aliveMembers = () => trip.members.filter((m) => !m.deleted);
    const aliveExpenses = () =>
      trip.expenses
        .filter((e) => !e.deleted)
        .sort((a, b) => (b.date || '').localeCompare(a.date || '') || (b.updatedAt || 0) - (a.updatedAt || 0));
    const aliveSettlements = () =>
      (trip.settlements || [])
        .filter((s) => !s.deleted)
        .sort((a, b) => (b.date || '').localeCompare(a.date || '') || (b.updatedAt || 0) - (a.updatedAt || 0));
    const memberName = (id) => {
      const m = trip.members.find((x) => x.id === id);
      return m ? m.name : '(已移除)';
    };
    const num2 = (n) => {
      const v = round2(n);
      return Number.isInteger(v) ? String(v) : v.toFixed(2);
    };
    const baseCur = () => (trip.currency || 'TWD').trim() || 'TWD';
    const fmt = (n) => `${num2(n)} ${baseCur()}`.trim(); // 主要幣別(台幣)
    const fmtCur = (n, cur) => `${num2(n)} ${cur || ''}`.trim(); // 指定幣別

    const $ = (id) => document.getElementById(id);
    const expCur = () => ($('expCurrency').value.trim() || baseCur());
    const expRate = () => {
      const r = Number($('expRate').value);
      return r > 0 ? r : 1;
    };
    const sumExactOrig = () =>
      [...document.querySelectorAll('[data-share]:checked')].reduce((s, cb) => {
        const el = document.querySelector(`[data-weight="${cb.dataset.share}"]`);
        return s + (Number(el?.value) || 0);
      }, 0);

    // ── 渲染 ────────────────────────────────────────────────────
    function render() {
      $('tripName').value = trip.name || '';
      $('tripCurrency').value = trip.currency || '';
      $('tripCode').value = trip.code || '';
      renderMembers();
      renderMe();
      renderPayer();
      renderSettleSelects();
      renderSplitList();
      renderExpenses();
      renderBalances();
    }

    function renderMe() {
      const sel = $('meSelect');
      const ms = aliveMembers();
      if (me && !ms.some((m) => m.id === me)) me = ''; // 我的成員被移除了
      sel.innerHTML = '<option value="">(請選擇)</option>' +
        ms.map((m) => `<option value="${m.id}">${escapeHtml(m.name)}</option>`).join('');
      sel.value = me;
      $('meHint').textContent = me
        ? `你是「${memberName(me)}」——只有你能改/刪自己記的支出`
        : '選好「我是誰」後,你記的支出只有你自己能改/刪';
    }

    function renderMembers() {
      const box = $('memberList');
      const ms = aliveMembers();
      if (!ms.length) {
        box.innerHTML = '<span class="ts-muted">還沒有成員,先新增幾個人。</span>';
        return;
      }
      box.innerHTML = ms
        .map(
          (m) =>
            `<span class="ts-chip">${escapeHtml(m.name)}<button data-act="delMember" data-id="${m.id}" title="移除">×</button></span>`,
        )
        .join('');
    }

    function renderPayer() {
      const sel = $('expPayer');
      const prev = sel.value;
      const ms = aliveMembers();
      sel.innerHTML = ms.map((m) => `<option value="${m.id}">${escapeHtml(m.name)}</option>`).join('');
      if (ms.some((m) => m.id === prev)) sel.value = prev;
    }

    // 分攤對象:依模式顯示 checkbox（even）或 checkbox＋數字（weight/exact）
    function renderSplitList(preset) {
      const mode = $('expMode').value;
      const box = $('splitList');
      const ms = aliveMembers();
      if (!ms.length) {
        box.innerHTML = '<span class="ts-muted">先新增成員才能分攤。</span>';
        return;
      }
      box.innerHTML = ms
        .map((m) => {
          const checked = preset ? preset.checked.has(m.id) : true;
          const val = preset && preset.values[m.id] != null ? preset.values[m.id] : mode === 'weight' ? 1 : '';
          const ph = mode === 'weight' ? '權重' : `金額(${expCur()})`;
          const numField =
            mode === 'even'
              ? ''
              : `<input type="number" min="0" step="${mode === 'weight' ? '1' : '0.01'}" data-weight="${m.id}" value="${val}" placeholder="${ph}" ${checked ? '' : 'disabled'} />`;
          return `<div class="ts-split-item">
            <label><input type="checkbox" data-share="${m.id}" ${checked ? 'checked' : ''} /> ${escapeHtml(m.name)}</label>
            ${numField}
          </div>`;
        })
        .join('');
    }

    // 回傳分攤設定。exact 模式回傳的是「原幣」金額(exactOrig),換算成基準額由 saveExpense 處理。
    function collectSplit() {
      const mode = $('expMode').value;
      const shared = [...document.querySelectorAll('[data-share]:checked')].map((el) => el.dataset.share);
      const out = { splitMode: mode, sharedBy: shared, weights: {}, exactOrig: {} };
      if (mode === 'weight' || mode === 'exact') {
        shared.forEach((id) => {
          const el = document.querySelector(`[data-weight="${id}"]`);
          const num = Number(el?.value) || 0;
          if (mode === 'weight') out.weights[id] = num;
          else out.exactOrig[id] = num;
        });
      }
      return out;
    }

    function renderExpenses() {
      const box = $('expenseList');
      const es = aliveExpenses();
      if (!es.length) {
        box.innerHTML = '<p class="ts-empty">還沒有任何支出。</p>';
        return;
      }
      const rows = es
        .map((e) => {
          const shares = shareOf(e);
          const who = Object.keys(shares).map(memberName).join('、');
          const cur = e.currency || baseCur();
          const foreign = cur !== baseCur() && e.rate && Number(e.rate) !== 1;
          const amtCell = foreign
            ? `${fmtCur(e.origAmount ?? e.amount, cur)}<br><span class="ts-muted">≈ ${fmt(e.amount)}</span>`
            : fmt(e.amount);
          const by = e.createdBy ? `<br><span class="ts-by">記錄:${escapeHtml(memberName(e.createdBy))}</span>` : '';
          const actions = isOwner(e)
            ? `<button class="ts-mini" data-act="editExp" data-id="${e.id}">改</button>
               <button class="ts-mini del" data-act="delExp" data-id="${e.id}">刪</button>`
            : `<span class="ts-lock" title="只有記錄者「${escapeHtml(memberName(e.createdBy))}」可以改/刪">🔒</span>`;
          return `<tr>
            <td>${escapeHtml(e.date || '')}</td>
            <td>${escapeHtml(e.desc || '')}${e.category ? `<br><span class="ts-muted">${escapeHtml(e.category)}</span>` : ''}${by}</td>
            <td class="num">${amtCell}</td>
            <td>${escapeHtml(memberName(e.payerId))}</td>
            <td><span class="ts-muted">${escapeHtml(who)}</span></td>
            <td class="num">${actions}</td>
          </tr>`;
        })
        .join('');
      box.innerHTML = `<table class="ts-table">
        <thead><tr><th>日期</th><th>說明</th><th class="num">金額</th><th>付款人</th><th>分攤</th><th></th></tr></thead>
        <tbody>${rows}</tbody>
        <tfoot><tr><td colspan="2"><b>合計</b></td><td class="num"><b>${fmt(totalSpent(trip.expenses))}</b></td><td colspan="3"></td></tr></tfoot>
      </table>`;
    }

    function renderBalances() {
      const net = computeBalances(trip.members, trip.expenses, trip.settlements);
      const bbox = $('balanceList');
      const ids = aliveMembers().map((m) => m.id);
      if (!ids.length) {
        bbox.innerHTML = '<p class="ts-empty">尚無資料。</p>';
        $('settleList').innerHTML = '';
        renderSettlements();
        return;
      }
      bbox.innerHTML = ids
        .map((id) => {
          const v = net[id] || 0;
          const cls = v > 0 ? 'ts-pos' : v < 0 ? 'ts-neg' : 'ts-muted';
          const sign = v > 0 ? '+' : '';
          return `<div class="ts-balance"><span>${escapeHtml(memberName(id))}</span><span class="${cls}">${sign}${fmt(v)}</span></div>`;
        })
        .join('');

      const transfers = settle(net);
      const sbox = $('settleList');
      sbox.innerHTML = transfers.length
        ? transfers
            .map(
              (t) =>
                `<div class="ts-settle" style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap">
                   <span>${escapeHtml(memberName(t.from))} → ${escapeHtml(memberName(t.to))}</span>
                   <input type="number" class="ts-w6" min="0" step="0.01" value="${num2(t.amount)}"
                     data-settle-amt="${t.from}:${t.to}" />
                   <span class="ts-muted">${baseCur()}</span>
                   <button class="ts-mini" data-act="markPaid" data-from="${t.from}" data-to="${t.to}">已還</button>
                 </div>`,
            )
            .join('')
        : '<p class="ts-empty">已結清,無需還款 🎉</p>';
      renderSettlements();
    }

    function renderSettlements() {
      const box = $('settlementList');
      const ss = aliveSettlements();
      if (!ss.length) {
        box.innerHTML = '<p class="ts-empty">還沒有還款紀錄。</p>';
        return;
      }
      box.innerHTML = ss
        .map((s) => {
          const by = s.createdBy ? ` · 記錄:${escapeHtml(memberName(s.createdBy))}` : '';
          const canDel = !s.createdBy || s.createdBy === me;
          const del = canDel
            ? `<button class="ts-mini del" data-act="delSettle" data-id="${s.id}">刪</button>`
            : `<span class="ts-lock" title="只有記錄者可刪">🔒</span>`;
          return `<div class="ts-settle" style="display:flex;justify-content:space-between;align-items:center;gap:.6rem">
            <span>${escapeHtml(memberName(s.from))} → ${escapeHtml(memberName(s.to))} <b>${fmt(s.amount)}</b>
              <span class="ts-by">${escapeHtml(s.date || '')}${by}</span></span>
            ${del}
          </div>`;
        })
        .join('');
    }

    // 還款用的成員下拉(手動新增)
    function renderSettleSelects() {
      const ms = aliveMembers();
      const opts = ms.map((m) => `<option value="${m.id}">${escapeHtml(m.name)}</option>`).join('');
      ['stFrom', 'stTo'].forEach((id) => {
        const sel = $(id);
        const prev = sel.value;
        sel.innerHTML = opts;
        if (ms.some((m) => m.id === prev)) sel.value = prev;
      });
    }

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    // ── 事件 ────────────────────────────────────────────────────
    function touchMeta() {
      trip.metaUpdatedAt = now();
    }

    $('tripName').addEventListener('input', (e) => { trip.name = e.target.value; touchMeta(); saveTrip(); scheduleSync(); });
    $('tripCurrency').addEventListener('input', (e) => {
      trip.currency = e.target.value; touchMeta(); saveTrip();
      renderSplitList(); refreshMoneyUI(); renderExpenses(); renderBalances(); scheduleSync();
    });
    $('tripCode').addEventListener('change', (e) => {
      const code = e.target.value.trim();
      saveTrip();               // 存回舊代碼
      trip = loadTrip(code);    // 切換到新代碼
      trip.code = code;
      loadMe(code);             // 換行程 → 換這台裝置在該行程的身分
      editingId = null;
      resetForm();
      saveTrip();
      render();
      setStatus(code ? `已切換到行程「${code}」` : '', 'ok');
      scheduleSync(); // 切到新代碼 → 自動拉回該行程雲端資料
    });

    $('meSelect').addEventListener('change', (e) => {
      me = e.target.value;
      saveMe();
      renderMe();
      renderExpenses(); // 擁有權變了,改/刪按鈕要重繪
    });

    $('addMember').addEventListener('click', addMember);
    $('memberName').addEventListener('keydown', (e) => { if (e.key === 'Enter') addMember(); });
    function addMember() {
      const name = $('memberName').value.trim();
      if (!name) return;
      const nm = { id: uid(), name, updatedAt: now() };
      trip.members.push(nm);
      // 這台裝置還沒設定「我是誰」時,新增的第一個成員預設為我(可再改)
      if (!me) { me = nm.id; saveMe(); }
      $('memberName').value = '';
      saveTrip();
      renderMembers();
      renderMe();
      renderPayer();
      renderSettleSelects();
      renderSplitList();
      scheduleSync();
    }

    $('memberList').addEventListener('click', (e) => {
      const btn = e.target.closest('[data-act="delMember"]');
      if (!btn) return;
      const m = trip.members.find((x) => x.id === btn.dataset.id);
      if (!m) return;
      if (!confirm(`移除成員「${m.name}」?\n(他已建立的支出仍會保留,但會顯示為「已移除」)`)) return;
      m.deleted = true; m.updatedAt = now();
      if (me === m.id) { me = ''; saveMe(); } // 移除的是我自己
      saveTrip();
      renderMembers();
      renderMe();
      renderPayer();
      renderSettleSelects();
      renderSplitList();
      renderExpenses();
      renderBalances();
      scheduleSync();
    });

    $('expMode').addEventListener('change', () => { renderSplitList(); refreshMoneyUI(); });
    $('expCurrency').addEventListener('input', () => { renderSplitList(); refreshMoneyUI(); });
    $('expRate').addEventListener('input', () => { recalcBaseFromInputs(); updateConvHint(); });
    $('expAmount').addEventListener('input', () => { recalcBaseFromInputs(); updateConvHint(); });
    $('expBaseAmount').addEventListener('input', recalcRateFromBase); // 改計價金額 → 反推匯率
    // 勾選/取消時同步啟用對應的數字欄位;exact 模式下改動金額時更新加總與換算
    $('splitList').addEventListener('change', (e) => {
      const cb = e.target.closest('[data-share]');
      if (!cb) return;
      const num = document.querySelector(`[data-weight="${cb.dataset.share}"]`);
      if (num) num.disabled = !cb.checked;
      refreshMoneyUI();
    });
    $('splitList').addEventListener('input', (e) => {
      if (e.target.matches('[data-weight]')) refreshMoneyUI();
    });

    $('saveExpense').addEventListener('click', saveExpense);
    $('cancelEdit').addEventListener('click', () => { editingId = null; resetForm(); });

    function saveExpense() {
      const desc = $('expDesc').value.trim();
      const payerId = $('expPayer').value;
      const currency = expCur();
      const rate = expRate();
      if (!aliveMembers().length) return setStatus('請先新增成員', 'err');
      if (!me) return setStatus('請先在「成員」區選擇『我是誰』,才能記帳', 'err');
      if (!payerId) return setStatus('請選擇付款人', 'err');
      const split = collectSplit();
      if (!split.sharedBy.length) return setStatus('請至少勾選一位分攤對象', 'err');

      // amount 一律是「計價幣別(台幣)基準額」,結算全用它 —— 以刷卡跳出的計價金額為準。
      let origAmount;
      let amount;
      let rateOut = rate;
      let exact = {};
      let exactOrig = {};
      if (split.splitMode === 'exact') {
        exactOrig = split.exactOrig;
        const derived = deriveExactBase(exactOrig, rate); // 各人原幣 × 匯率 → 基準額
        exact = derived.exact;
        amount = derived.total; // 總額 = 各人基準額之和,分攤必定加總相等
        origAmount = round2(split.sharedBy.reduce((a, id) => a + (exactOrig[id] || 0), 0));
        if (!(origAmount > 0)) return setStatus('請填寫每個人的指定金額', 'err');
      } else {
        origAmount = Number($('expAmount').value);
        if (!(origAmount > 0)) return setStatus('請輸入正確的原幣金額', 'err');
        // 計價金額(刷卡金額)為準;沒填才用 原幣×匯率 推算
        const typedBase = Number($('expBaseAmount').value);
        amount = typedBase > 0 ? round2(typedBase) : toBase(origAmount, rate);
        // 讓儲存的匯率與計價金額一致(供顯示/日後編輯)
        rateOut = origAmount > 0 ? Math.round((amount / origAmount) * 1e6) / 1e6 : rate;
      }

      const base = {
        desc,
        amount,
        origAmount: round2(origAmount),
        currency,
        baseCurrency: baseCur(),
        rate: rateOut,
        payerId,
        date: $('expDate').value || '',
        category: $('expCategory').value.trim(),
        splitMode: split.splitMode,
        sharedBy: split.sharedBy,
        weights: split.weights,
        exact,
        exactOrig,
        updatedAt: now(),
      };
      if (editingId) {
        const idx = trip.expenses.findIndex((x) => x.id === editingId);
        if (idx >= 0) {
          if (!isOwner(trip.expenses[idx])) return setStatus('這筆是別人記的,不能修改', 'err');
          trip.expenses[idx] = { ...trip.expenses[idx], ...base }; // 保留原 createdBy
        }
        editingId = null;
      } else {
        trip.expenses.push({ id: uid(), createdBy: me, ...base });
      }
      rememberCurrency(currency, rateOut); // 供下一筆預帶
      saveTrip();
      resetForm();
      renderExpenses();
      renderBalances();
      setStatus('已儲存', 'ok');
      scheduleSync();
    }

    function resetForm() {
      $('expDesc').value = '';
      $('expAmount').value = '';
      $('expBaseAmount').value = '';
      $('expCategory').value = '';
      $('expMode').value = 'even';
      // 幣別預帶上一次填的內容(沒有紀錄時用主要幣別)
      const cur = lastCurrency || baseCur();
      $('expCurrency').value = cur;
      $('expRate').value = cur === baseCur() ? '1' : lastRate || '1';
      renderSplitList();
      refreshMoneyUI();
      $('saveExpense').textContent = '＋ 新增支出';
      $('cancelEdit').style.display = editingId ? 'inline-block' : 'none';
    }

    // 三個金額欄位維持 計價金額 = 原幣金額 × 匯率 的連動:
    //   改 原幣金額 / 匯率 → 重算「計價金額」
    //   改 計價金額(刷卡跳出的) → 反推「匯率」(以刷卡金額為準,計算也以它為準)
    // exact 模式的原幣金額與計價金額皆為各人加總,唯讀;原幣別＝計價幣別時匯率鎖 1。
    const isExactMode = () => $('expMode').value === 'exact';

    // exact 模式各人「計價幣別(基準額)」加總。
    function sumExactBase(rate) {
      return [...document.querySelectorAll('[data-share]:checked')].reduce((s, cb) => {
        const el = document.querySelector(`[data-weight="${cb.dataset.share}"]`);
        return round2(s + toBase(Number(el?.value) || 0, rate));
      }, 0);
    }

    // 依欄位狀態重新整理三個金額欄的可編輯性與自動值。
    function refreshMoneyUI() {
      const exact = isExactMode();
      const isBase = expCur() === baseCur();
      $('expBaseCur').value = baseCur();

      $('expAmount').disabled = exact;
      $('expAmountLabel').textContent = exact ? '原幣金額(自動加總)' : '原幣金額';
      if (exact) $('expAmount').value = num2(sumExactOrig());

      $('expRate').disabled = isBase;
      if (isBase) $('expRate').value = '1';

      // 計價金額:exact(各人加總)或 原幣別＝計價幣別(等同原幣金額)時為自動、唯讀
      $('expBaseAmount').disabled = exact || isBase;
      recalcBaseFromInputs();
      updateConvHint();
    }

    // 計價金額 = 原幣金額 × 匯率(exact 為各人基準額加總),寫回顯示。
    function recalcBaseFromInputs() {
      const rate = expRate();
      const base = isExactMode()
        ? sumExactBase(rate)
        : toBase(Number($('expAmount').value) || 0, rate);
      $('expBaseAmount').value = base > 0 ? num2(base) : '';
    }

    // 使用者改「計價金額」→ 反推匯率 = 計價金額 ÷ 原幣金額。
    function recalcRateFromBase() {
      const orig = Number($('expAmount').value) || 0;
      const base = Number($('expBaseAmount').value) || 0;
      if (orig > 0 && base > 0) {
        $('expRate').value = String(Math.round((base / orig) * 1e6) / 1e6);
      }
      updateConvHint();
    }

    function updateConvHint() {
      const cur = expCur();
      const rate = expRate();
      const orig = isExactMode() ? sumExactOrig() : Number($('expAmount').value) || 0;
      const base = Number($('expBaseAmount').value) || 0;
      const rateStr = String(Math.round(rate * 1e6) / 1e6); // 保留匯率精度,不做 2 位進位
      $('convHint').textContent =
        cur === baseCur() || !(orig > 0) || !(base > 0)
          ? ''
          : `${fmtCur(orig, cur)} × ${rateStr} ≈ ${fmt(base)}`;
    }

    $('expenseList').addEventListener('click', (e) => {
      const btn = e.target.closest('[data-act]');
      if (!btn) return;
      const id = btn.dataset.id;
      if (btn.dataset.act === 'delExp') {
        const ex = trip.expenses.find((x) => x.id === id);
        if (!ex) return;
        if (!isOwner(ex)) return setStatus('這筆是別人記的,不能刪除', 'err');
        ex.deleted = true; ex.updatedAt = now();
        if (editingId === id) { editingId = null; resetForm(); }
        saveTrip();
        renderExpenses();
        renderBalances();
        scheduleSync();
        // 誤刪救回:幾秒內可一鍵復原
        showUndo(`已刪除「${ex.desc || '無說明'} ${fmt(ex.amount)}」`, () => {
          ex.deleted = false; ex.updatedAt = now();
          saveTrip();
          renderExpenses();
          renderBalances();
          scheduleSync();
        });
      } else if (btn.dataset.act === 'editExp') {
        const ex = trip.expenses.find((x) => x.id === id);
        if (ex && !isOwner(ex)) return setStatus('這筆是別人記的,不能修改', 'err');
        loadExpenseIntoForm(id);
      }
    });

    // ── 誤刪救回 toast ──────────────────────────────────────────
    let undoTimer = null;
    function showUndo(msg, onUndo) {
      const t = $('undoToast');
      clearTimeout(undoTimer);
      t.innerHTML = '';
      const span = document.createElement('span');
      span.textContent = msg;
      const btn = document.createElement('button');
      btn.textContent = '復原';
      btn.addEventListener('click', () => { hideUndo(); onUndo(); });
      t.append(span, btn);
      t.classList.add('show');
      undoTimer = setTimeout(hideUndo, 6000);
    }
    function hideUndo() {
      clearTimeout(undoTimer);
      $('undoToast').classList.remove('show');
    }

    // ── 還款 ────────────────────────────────────────────────────
    function todayStr() {
      const d = $('stDate').value;
      return d || '';
    }
    function addSettlementRecord(from, to, amount, date) {
      if (!me) { setStatus('請先在「成員」區選擇『我是誰』,才能記還款', 'err'); return false; }
      if (!from || !to || from === to) { setStatus('請選擇不同的付款人與收款人', 'err'); return false; }
      if (!(amount > 0)) { setStatus('請輸入正確的還款金額', 'err'); return false; }
      trip.settlements = trip.settlements || [];
      trip.settlements.push({
        id: uid(), from, to, amount: round2(amount), date: date || '',
        createdBy: me, updatedAt: now(),
      });
      saveTrip();
      renderBalances();
      scheduleSync();
      return true;
    }

    // 建議還款列的「已還」:讀該列可編輯的金額,記成一筆還款
    $('settleList').addEventListener('click', (e) => {
      const btn = e.target.closest('[data-act="markPaid"]');
      if (!btn) return;
      const { from, to } = btn.dataset;
      const input = document.querySelector(`[data-settle-amt="${from}:${to}"]`);
      const amount = Number(input?.value) || 0;
      if (addSettlementRecord(from, to, amount, '')) {
        setStatus(`已記還款:${memberName(from)} → ${memberName(to)} ${fmt(amount)}`, 'ok');
      }
    });

    // 手動新增還款
    $('addSettlement').addEventListener('click', () => {
      const from = $('stFrom').value, to = $('stTo').value;
      const amount = Number($('stAmount').value) || 0;
      if (addSettlementRecord(from, to, amount, todayStr())) {
        $('stAmount').value = '';
        setStatus('已新增還款紀錄', 'ok');
      }
    });

    // 刪除還款紀錄(記錄者本人)+ 誤刪救回
    $('settlementList').addEventListener('click', (e) => {
      const btn = e.target.closest('[data-act="delSettle"]');
      if (!btn) return;
      const s = (trip.settlements || []).find((x) => x.id === btn.dataset.id);
      if (!s) return;
      if (s.createdBy && s.createdBy !== me) return setStatus('這筆是別人記的,不能刪除', 'err');
      s.deleted = true; s.updatedAt = now();
      saveTrip();
      renderBalances();
      scheduleSync();
      showUndo(`已刪除還款「${memberName(s.from)} → ${memberName(s.to)} ${fmt(s.amount)}」`, () => {
        s.deleted = false; s.updatedAt = now();
        saveTrip();
        renderBalances();
        scheduleSync();
      });
    });

    function loadExpenseIntoForm(id) {
      const e = trip.expenses.find((x) => x.id === id);
      if (!e) return;
      editingId = id;
      $('expDesc').value = e.desc || '';
      $('expCurrency').value = e.currency || baseCur();
      $('expRate').value = e.rate ?? 1;
      $('expAmount').value = e.origAmount ?? e.amount ?? ''; // 顯示原幣金額
      $('expCategory').value = e.category || '';
      $('expDate').value = e.date || '';
      $('expMode').value = e.splitMode || 'even';
      if (aliveMembers().some((m) => m.id === e.payerId)) $('expPayer').value = e.payerId;
      const values = {};
      if (e.splitMode === 'weight') Object.assign(values, e.weights || {});
      // exact:優先用原幣金額回填,舊資料(無 exactOrig)退回用基準額
      if (e.splitMode === 'exact') Object.assign(values, e.exactOrig || e.exact || {});
      renderSplitList({ checked: new Set(e.sharedBy || []), values });
      refreshMoneyUI();
      // 以儲存的計價金額(基準額)為準顯示,不用 原幣×匯率 重算以免進位差
      if (!isExactMode() && !$('expBaseAmount').disabled && e.amount != null) {
        $('expBaseAmount').value = num2(e.amount);
        updateConvHint();
      }
      $('saveExpense').textContent = '✓ 更新支出';
      $('cancelEdit').style.display = 'inline-block';
      $('expDesc').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    // ── 同步 / 匯出入 ──────────────────────────────────────────
    function setStatus(msg, kind) {
      const el = $('syncStatus');
      el.textContent = msg;
      el.className = 'ts-status ' + (kind === 'err' ? 'err' : kind === 'ok' ? 'ok' : 'ts-muted');
    }

    $('endpoint').addEventListener('change', (e) => {
      localStorage.setItem(LS_ENDPOINT, e.target.value.trim());
    });

    // 自動同步:開關存本機;有設端點+代碼才會作用。
    let autoSync = true;
    $('autoSync').addEventListener('change', (e) => {
      autoSync = e.target.checked;
      try { localStorage.setItem(LS_AUTOSYNC, autoSync ? '1' : '0'); } catch (_) {}
      if (autoSync) scheduleSync();
    });

    // 任何動到共享資料的操作後呼叫:防抖 1.2 秒,把連續操作合併成一次同步。
    let syncTimer = null;
    function scheduleSync() {
      if (!autoSync) return;
      if (!$('endpoint').value.trim() || !trip.code) return; // 沒設定就純本機,不自動同步
      clearTimeout(syncTimer);
      setStatus('稍後自動同步…');
      syncTimer = setTimeout(() => sync({ auto: true }), 1200);
    }

    $('syncBtn').addEventListener('click', () => sync());
    let syncing = false, syncQueued = false;
    async function sync(opts) {
      const auto = opts && opts.auto;
      const endpoint = $('endpoint').value.trim();
      if (!endpoint) return auto ? null : setStatus('請先設定 Google Apps Script 端點(見下方說明)', 'err');
      if (!trip.code) return auto ? null : setStatus('請先設定「行程代碼」才能共享', 'err');
      if (syncing) { syncQueued = true; return; } // 同步進行中 → 記下待補,結束後再跑一次
      clearTimeout(syncTimer);
      syncing = true;
      localStorage.setItem(LS_ENDPOINT, endpoint);
      setStatus(auto ? '自動同步中…' : '同步中…');
      try {
        const res = await fetch(`${endpoint}?code=${encodeURIComponent(trip.code)}`);
        const remote = await res.json();
        if (!remote.ok) throw new Error(remote.error || '讀取失敗');
        const merged = mergeTrips(trip, remote.data);
        const put = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' }, // 避免 CORS preflight
          body: JSON.stringify({ code: trip.code, data: merged }),
        });
        const pr = await put.json();
        if (!pr.ok) throw new Error(pr.error || '寫入失敗');
        // 新版後端會在鎖內原子合併並回傳權威結果;舊版沒有 data 時退回本地合併版
        trip = pr.data || merged;
        saveTrip();
        render();
        setStatus(`${auto ? '已自動同步' : '已與雲端同步'} ✓ (${new Date().toLocaleTimeString()})`, 'ok');
      } catch (err) {
        setStatus(`同步失敗:${err.message}。請確認端點網址正確、且部署權限設為「任何人」。`, 'err');
      } finally {
        syncing = false;
        if (syncQueued) { syncQueued = false; sync({ auto: true }); } // 補跑最新一次
      }
    }

    // 產生「朋友點開即自動帶入並同步」的分享連結
    $('shareBtn').addEventListener('click', async () => {
      const endpoint = $('endpoint').value.trim();
      if (!endpoint) return setStatus('請先設定端點網址,才能產生分享連結', 'err');
      if (!trip.code) return setStatus('請先設定「行程代碼」,才能產生分享連結', 'err');
      const payload = { e: endpoint, c: trip.code, n: trip.name || '', cur: trip.currency || '' };
      const url = `${location.origin}${location.pathname}#s=${encodeShare(payload)}`;
      try {
        await navigator.clipboard.writeText(url);
        setStatus('分享連結已複製 ✓,傳給同行的人點開即可', 'ok');
      } catch (_) {
        prompt('複製這段分享連結給同行的人:', url); // clipboard 不可用時的退路
      }
    });

    // 從網址 #s=<base64> 帶入端點/行程代碼,並自動同步。回傳是否成功帶入。
    async function importFromHash() {
      const m = (location.hash || '').match(/[#&]s=([^&]+)/);
      if (!m) return false;
      let cfg;
      try {
        cfg = decodeShare(decodeURIComponent(m[1]));
      } catch (_) {
        setStatus('分享連結格式不正確', 'err');
        return false;
      }
      if (cfg.e) { $('endpoint').value = cfg.e; localStorage.setItem(LS_ENDPOINT, cfg.e); }
      const code = (cfg.c || '').trim();
      if (code) {
        saveTrip();            // 存回目前這份
        trip = loadTrip(code); // 切到分享的行程代碼
        trip.code = code;
        loadMe(code);
        if (!trip.name && cfg.n) trip.name = cfg.n;
        if (!trip.currency && cfg.cur) trip.currency = cfg.cur;
        saveTrip();
      }
      // 帶入後清掉網址上的 hash,避免每次重新整理又觸發
      history.replaceState(null, '', location.pathname + location.search);
      render();
      resetForm();
      if (cfg.e && code) { setStatus('已從分享連結帶入,正在同步…'); await sync(); }
      return true;
    }

    $('exportBtn').addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(trip, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `travel-split-${trip.code || 'trip'}.json`;
      a.click();
      URL.revokeObjectURL(a.href);
    });
    $('importBtn').addEventListener('click', () => $('importFile').click());
    $('importFile').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      try {
        const data = JSON.parse(await file.text());
        trip = mergeTrips(trip, data); // 與現有資料合併,不覆蓋
        saveTrip();
        render();
        setStatus('已匯入並合併', 'ok');
        scheduleSync();
      } catch (_) {
        setStatus('匯入失敗:檔案格式不正確', 'err');
      }
      e.target.value = '';
    });

    $('resetBtn').addEventListener('click', () => {
      if (!confirm('確定要清空此行程的所有本機資料嗎?(雲端與其他人的資料不受影響)')) return;
      trip = emptyTrip(trip.code);
      editingId = null;
      saveTrip();
      resetForm();
      render();
      setStatus('已清空此行程', 'ok');
    });

    // Apps Script 範本 + 一鍵複製
    const GAS = `// 旅遊分帳 —— Google Apps Script 後端(貼到試算表的 Apps Script 編輯器)
const SHEET = 'trips';

function sheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(SHEET);
  if (!sh) { sh = ss.insertSheet(SHEET); sh.appendRow(['code', 'updatedAt', 'data']); }
  return sh;
}
function findRow_(sh, code) {
  const last = sh.getLastRow();
  if (last < 2) return -1;
  const codes = sh.getRange(2, 1, last - 1, 1).getValues();
  for (let i = 0; i < codes.length; i++) if (String(codes[i][0]) === String(code)) return i + 2;
  return -1;
}
function json_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}
function doGet(e) {
  const code = (e.parameter.code || '').trim();
  if (!code) return json_({ ok: false, error: 'no code' });
  const sh = sheet_(), r = findRow_(sh, code);
  if (r < 0) return json_({ ok: true, data: null });
  const raw = sh.getRange(r, 3).getValue();
  return json_({ ok: true, data: raw ? JSON.parse(raw) : null });
}
// 伺服器端合併(CRDT 式 last-write-wins),與前端 mergeTrips 一致。
function mergeById_(a, b) {
  var map = {};
  function consider(item) {
    if (!item || item.id == null) return;
    var prev = map[item.id];
    if (!prev || (item.updatedAt || 0) >= (prev.updatedAt || 0)) map[item.id] = item;
  }
  (a || []).forEach(consider);
  (b || []).forEach(consider);
  return Object.keys(map).map(function (k) { return map[k]; });
}
function mergeTrips_(a, b) {
  if (!a) return b || null;
  if (!b) return a || null;
  var aMeta = a.metaUpdatedAt || 0, bMeta = b.metaUpdatedAt || 0;
  var win = bMeta > aMeta ? b : a;
  return {
    code: a.code || b.code, name: win.name, currency: win.currency,
    metaUpdatedAt: Math.max(aMeta, bMeta),
    members: mergeById_(a.members, b.members),
    expenses: mergeById_(a.expenses, b.expenses),
    settlements: mergeById_(a.settlements, b.settlements),
  };
}
function doPost(e) {
  const lock = LockService.getScriptLock();
  lock.waitLock(20000); // 讀→合併→寫在鎖內原子完成,多人同時同步也不會掉資料
  try {
    const body = JSON.parse(e.postData.contents);
    const code = (body.code || '').trim();
    if (!code) return json_({ ok: false, error: 'no code' });
    const sh = sheet_(), r = findRow_(sh, code);
    // 讀出目前雲端這格,與送來的資料合併(而非直接覆蓋)
    let stored = null;
    if (r >= 0) { const raw = sh.getRange(r, 3).getValue(); stored = raw ? JSON.parse(raw) : null; }
    const merged = mergeTrips_(stored, body.data) || body.data || null;
    const row = [code, new Date().toISOString(), JSON.stringify(merged)];
    if (r < 0) sh.appendRow(row); else sh.getRange(r, 1, 1, 3).setValues([row]);
    try { writeDetail_(merged); } catch (err) {} // 明細分頁失敗不影響主同步
    return json_({ ok: true, data: merged }); // 回傳合併結果,前端採用為權威版本
  } finally {
    lock.releaseLock();
  }
}

// ── 可讀明細分頁(每次同步自動重建,唯讀鏡像;手改不會回寫) ──────────
function detailName_(code) {
  // 分頁名稱不可含 : / ? * [ ] \\,逐字淨化(避免 regex 轉義問題)
  var bad = [':', '/', '?', '*', '[', ']', String.fromCharCode(92)];
  var raw = '明細_' + (code || 'trip');
  var safe = '';
  for (var i = 0; i < raw.length; i++) {
    safe += bad.indexOf(raw.charAt(i)) >= 0 ? '_' : raw.charAt(i);
  }
  return safe.slice(0, 90);
}
function writeDetail_(data) {
  if (!data) return;
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sh = ss.getSheetByName(detailName_(data.code)) || ss.insertSheet(detailName_(data.code));
  sh.clear();

  const nameOf = {};
  (data.members || []).forEach(function (m) { nameOf[m.id] = m.name; });
  const cur = data.currency || 'TWD';

  const rows = [['日期', '說明', '分類', '原幣別', '原幣金額', '匯率', '計價金額(' + cur + ')', '付款人', '分攤成員']];
  var total = 0;
  (data.expenses || [])
    .filter(function (x) { return !x.deleted; })
    .sort(function (a, b) { return String(a.date || '').localeCompare(String(b.date || '')); })
    .forEach(function (x) {
      var who = (x.sharedBy || []).map(function (id) { return nameOf[id] || '(已移除)'; }).join('、');
      total += Number(x.amount) || 0;
      rows.push([
        x.date || '', x.desc || '', x.category || '',
        x.currency || cur,
        x.origAmount != null ? x.origAmount : x.amount,
        x.rate != null ? x.rate : 1,
        Number(x.amount) || 0,
        nameOf[x.payerId] || '(已移除)',
        who,
      ]);
    });
  rows.push(['', '', '', '', '', '合計', Math.round(total * 100) / 100, '', '']);

  // 已還款紀錄(接在支出下方,空一列後另起一段)
  var setts = (data.settlements || []).filter(function (s) { return !s.deleted; });
  if (setts.length) {
    rows.push(['', '', '', '', '', '', '', '', '']);
    rows.push(['── 已還款 ──', '日期', '誰付', '付給誰', '金額(' + cur + ')', '記錄者', '', '', '']);
    setts.sort(function (a, b) { return String(a.date || '').localeCompare(String(b.date || '')); })
      .forEach(function (s) {
        rows.push(['', s.date || '', nameOf[s.from] || '(已移除)', nameOf[s.to] || '(已移除)',
          Number(s.amount) || 0, nameOf[s.createdBy] || '', '', '', '']);
      });
  }

  sh.getRange(1, 1, rows.length, rows[0].length).setValues(rows);
  sh.getRange(1, 1, 1, rows[0].length).setFontWeight('bold');
  sh.setFrozenRows(1);
}`;
    $('gasCode').textContent = GAS;
    $('copyGas').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(GAS);
        $('copyGas').textContent = '已複製 ✓';
        setTimeout(() => ($('copyGas').textContent = '複製程式碼'), 1500);
      } catch (_) {
        setStatus('複製失敗,請手動選取', 'err');
      }
    });

    // ── 啟動 ────────────────────────────────────────────────────
    (async function init() {
      const lastCode = localStorage.getItem(LS_LAST) || '';
      trip = loadTrip(lastCode);
      trip.code = trip.code || lastCode;
      loadMe(trip.code);
      lastCurrency = localStorage.getItem(LS_LASTCUR) || '';
      lastRate = localStorage.getItem(LS_LASTRATE) || '';
      autoSync = localStorage.getItem(LS_AUTOSYNC) !== '0'; // 預設開
      $('autoSync').checked = autoSync;
      $('endpoint').value = localStorage.getItem(LS_ENDPOINT) || '';
      render();
      resetForm();
      // 若網址帶有 #s=<base64> 分享設定,帶入並自動同步
      await importFromHash();
    })();
  </script>
</BaseLayout>
