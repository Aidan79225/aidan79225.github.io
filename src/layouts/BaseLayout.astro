---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Seo from '../components/Seo.astro';
const {
  title = "Aidan's Blog",
  description,
  image,
  type = 'website',
  publishedTime,
  tags = [],
  contentLicense = false,
} = Astro.props;
// Cloudflare Web Analytics beacon token (from the CF dashboard). Public by
// design — it only identifies which site to attribute pageviews to. Set it
// here or via the PUBLIC_CF_BEACON_TOKEN env var; empty = no beacon emitted.
const CF_BEACON_TOKEN = import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? '';

const SITE_NAME = "Aidan's Blog";
const DEFAULT_DESCRIPTION =
  'Aidan 的部落格 —— 用圖像加精簡的文字,把資料工程與技術領導講清楚。';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const desc = description ?? DEFAULT_DESCRIPTION;
const ogImage = new URL(image ?? '/og/default.png', Astro.site).href;
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} · ${SITE_NAME}`;
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1f2330" />
    {import.meta.env.PROD && (
      // Offline support: register the service worker generated by
      // scripts/gen-sw.mjs (precaches the whole site; see that file).
      // PROD-only — `astro dev` serves no sw.js and must not register one.
      <script is:inline>
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          });
        }
      </script>
    )}
    <title>{fullTitle}</title>
    <Seo
      title={title}
      description={desc}
      canonical={canonical}
      image={ogImage}
      type={type}
      siteName={SITE_NAME}
      publishedTime={publishedTime}
      tags={tags}
    />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={new URL('/rss.xml', Astro.site).href} />
  </head>
  <body class="bg-base text-ink min-h-screen">
    <Nav />
    <main class="max-w-3xl mx-auto px-4 py-8">
      <slot />
    </main>
    <footer class="max-w-3xl mx-auto px-4 py-8 mt-12 border-t border-line text-muted text-sm">
      © 2026 Aidan's Blog{contentLicense && (
        <Fragment> · 本文採用 <a href="https://creativecommons.org/licenses/by/4.0/" rel="license" target="_blank" class="text-accent hover:underline">CC BY 4.0</a> 授權</Fragment>
      )}
    </footer>
    {CF_BEACON_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}
      ></script>
    )}
  </body>
</html>
