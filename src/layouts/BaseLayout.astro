---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Seo from '../components/Seo.astro';
import { HTML_LANG, OG_LOCALE, ui, type Locale } from '../lib/i18n';
const {
  title = "Aidan's Blog",
  description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  contentLicense = false,
  locale = 'zh-hant' as Locale,
  alternates = [],
} = Astro.props;
const t = ui[locale as Locale];

// A zh-Hant page rendered under the en locale is an i18n fallback
// (untranslated content served so /en/ navigation never 404s). Detect it via
// Astro.currentLocale, not the pathname: for rewrite-generated pages the
// pathname is already the zh route (/tech/), while manually authored fallback
// routes (en/blog/[slug]) carry the /en/ prefix — strip it for the canonical
// so search engines index only the original.
const path = Astro.url.pathname;
const isFallback = locale === 'zh-hant' && Astro.currentLocale === 'en';
const canonicalPath =
  isFallback && (path === '/en' || path.startsWith('/en/'))
    ? path.replace(/^\/en/, '') || '/'
    : path;
// Cloudflare Web Analytics beacon token (from the CF dashboard). Public by
// design — it only identifies which site to attribute pageviews to. Set it
// here or via the PUBLIC_CF_BEACON_TOKEN env var; empty = no beacon emitted.
const CF_BEACON_TOKEN = import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? '';

const SITE_NAME = "Aidan's Blog";
const DEFAULT_DESCRIPTION =
  'Aidan 的部落格 —— 用一張圖加精簡的文字,把複雜的系統講清楚。';
const canonical = new URL(canonicalPath, Astro.site).href;
const desc = description ?? DEFAULT_DESCRIPTION;
const ogImage = new URL(image ?? '/og/default.png', Astro.site).href;
const fullTitle = title === SITE_NAME ? SITE_NAME : `${title} · ${SITE_NAME}`;
---
<!doctype html>
<html lang={HTML_LANG[locale as Locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1f2330" />
    <script is:inline>
      // Re-apply the reader's saved skin before first paint — anything later
      // (a module script, an island) would flash the default dark first.
      // Dark stays the default: the site's own look, opted out of explicitly.
      (function () {
        var t = 'dark';
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') t = saved;
        } catch (e) {
          // Storage blocked — fall through to the default.
        }
        document.documentElement.dataset.theme = t;
        if (t === 'light') {
          // The <meta> above is already parsed at this point.
          var m = document.querySelector('meta[name="theme-color"]');
          if (m) m.setAttribute('content', '#ffffff');
        }
      })();
    </script>
    {import.meta.env.PROD && (
      // Offline support: register the service worker generated by
      // scripts/gen-sw.mjs (precaches the whole site; see that file).
      // PROD-only — `astro dev` serves no sw.js and must not register one.
      <script is:inline>
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          });
          // 離線快取進度:安裝中的 SW 會 postMessage {type:'sw-precache', done, total}。
          // 右下角一顆小藥丸,pointer-events:none 不擋任何操作;快取很快跑完
          // (600ms 內)就完全不出現,完成後顯示「已可離線閱讀」再淡出。
          var swBox = null, swFill = null, swLabel = null, swHide = null, swFirst = 0;
          navigator.serviceWorker.addEventListener('message', (ev) => {
            var d = ev.data;
            if (!d || d.type !== 'sw-precache' || !d.total) return;
            if (!swFirst) swFirst = Date.now();
            if (!swBox) {
              swBox = document.createElement('div');
              swBox.setAttribute('role', 'status');
              swBox.style.cssText = 'position:fixed;right:12px;bottom:calc(12px + env(safe-area-inset-bottom,0px));z-index:9999;display:flex;align-items:center;gap:8px;padding:6px 12px;border-radius:999px;background:var(--color-surface);border:1px solid var(--color-line);color:var(--color-muted);font-size:12px;line-height:1;pointer-events:none;opacity:0;transition:opacity .3s;';
              var track = document.createElement('span');
              track.style.cssText = 'width:72px;height:3px;border-radius:2px;background:var(--color-line);overflow:hidden;display:inline-block;';
              swFill = document.createElement('span');
              swFill.style.cssText = 'display:block;height:100%;width:0%;background:var(--color-accent);transition:width .2s;';
              track.appendChild(swFill);
              swLabel = document.createElement('span');
              swBox.appendChild(track);
              swBox.appendChild(swLabel);
              document.body.appendChild(swBox);
            }
            var pct = Math.min(100, Math.round((d.done / d.total) * 100));
            swFill.style.width = pct + '%';
            if (d.done >= d.total) {
              if (swBox.style.opacity === '1') {
                swLabel.textContent = '已可離線閱讀';
                clearTimeout(swHide);
                swHide = setTimeout(() => { swBox.style.opacity = '0'; }, 2000);
              }
              return;
            }
            swLabel.textContent = '離線快取中 ' + pct + '%';
            if (Date.now() - swFirst > 600) swBox.style.opacity = '1';
          });
        }
      </script>
    )}
    <title>{fullTitle}</title>
    <Seo
      title={title}
      description={desc}
      canonical={canonical}
      image={ogImage}
      type={type}
      siteName={SITE_NAME}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      ogLocale={OG_LOCALE[locale as Locale]}
      alternates={alternates}
    />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={new URL('/rss.xml', Astro.site).href} />
  </head>
  <body class="bg-base text-ink min-h-screen">
    <Nav />
    {isFallback && (
      <div class="bg-surface border-b border-line" lang="en">
        <p class="max-w-3xl mx-auto px-4 py-2 text-xs text-muted m-0">
          🌐 This page hasn't been translated yet — showing the original Chinese.
          <a href="/en/" class="text-accent hover:underline">Translated posts</a>
        </p>
      </div>
    )}
    {isFallback && (
      // Safety net for fallback pages generated by the i18n rewrite (guides,
      // markdown bodies, anything a component missed): keep every internal
      // link inside /en/. Cross-language links don't exist on fallback pages,
      // so a blanket rewrite is safe.
      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          for (const a of document.querySelectorAll('a[href^="/"]')) {
            const h = a.getAttribute('href');
            if (h !== '/en' && !h.startsWith('/en/')) a.setAttribute('href', '/en' + h);
          }
        });
      </script>
    )}
    <main class="max-w-3xl mx-auto px-4 py-8">
      <slot />
    </main>
    <footer class="max-w-3xl mx-auto px-4 py-8 mt-12 border-t border-line text-muted text-sm">
      © 2026 Aidan's Blog{contentLicense && (
        <Fragment> · {t.licensePrefix}<a href="https://creativecommons.org/licenses/by/4.0/" rel="license" target="_blank" class="text-accent hover:underline">CC BY 4.0</a>{t.licenseSuffix}</Fragment>
      )}
    </footer>
    {CF_BEACON_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}
      ></script>
    )}
  </body>
</html>
