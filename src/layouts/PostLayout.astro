---
import type { CollectionEntry } from 'astro:content';
import { getPublishedPosts, getTranslation, postLang, postUrl } from '../lib/posts';
import BaseLayout from './BaseLayout.astro';
import AuthorCard from '../components/AuthorCard.astro';
import Comments from '../components/Comments.astro';
import Toc from '../components/Toc.astro';
import { getBacklinks } from '../lib/backlinks';
import { groupBySection } from '../lib/group-backlinks.mjs';
import { excerpt } from '../lib/post';
import { seriesByName } from '../data/series';
import { currentLocale, withLocale, DATE_LOCALE, HTML_LANG, ui } from '../lib/i18n';
import type { MarkdownHeading } from 'astro';
import 'katex/dist/katex.min.css';
interface Props { post: CollectionEntry<'blog'>; headings?: MarkdownHeading[]; }
const { post, headings = [] } = Astro.props;
const { title, date, updated, category, tags = [], series, description } = post.data;
const metaDescription = description ?? excerpt(post.body ?? '', 140);

const lang = postLang(post);
const t = ui[lang];
const dateLocale = DATE_LOCALE[lang];

// In-page links follow the URL locale, not the content language: a zh post
// served as /en/blog/<slug>/ fallback keeps its tag/series/backlink links
// inside /en/ (which always resolves — real translation or zh fallback).
const locale = currentLocale(Astro.currentLocale);
const l = (path: string) => withLocale(locale, path);
const blogUrl = (p: CollectionEntry<'blog'>) => l(`/blog/${p.id.replace(/^en\//, '')}/`);

// The same post in the other language, if published: powers the switcher
// banner and the hreflang alternates. zh is x-default (site's native tongue).
const translation = await getTranslation(post);
const alternates = translation
  ? [
      lang === 'en'
        ? { hreflang: 'zh-Hant', href: new URL(postUrl(translation), Astro.site).href }
        : { hreflang: 'zh-Hant', href: new URL(postUrl(post), Astro.site).href },
      lang === 'en'
        ? { hreflang: 'en', href: new URL(postUrl(post), Astro.site).href }
        : { hreflang: 'en', href: new URL(postUrl(translation), Astro.site).href },
      {
        hreflang: 'x-default',
        href: new URL(postUrl(lang === 'en' ? translation : post), Astro.site).href,
      },
    ]
  : [];

let seriesPosts: CollectionEntry<'blog'>[] = [];
let prevPost: CollectionEntry<'blog'> | null = null;
let nextPost: CollectionEntry<'blog'> | null = null;
if (series) {
  seriesPosts = (await getPublishedPosts(lang))
    .filter((p) => p.data.series === series)
    .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
  const idx = seriesPosts.findIndex((p) => p.id === post.id);
  prevPost = idx > 0 ? seriesPosts[idx - 1] : null;
  nextPost = idx >= 0 && idx < seriesPosts.length - 1 ? seriesPosts[idx + 1] : null;
}
const backlinkGroups = groupBySection(await getBacklinks(post.id), headings);

// TOC: h2/h3 only (deeper is noise), skipped entirely for short posts.
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocHeadings.length >= 3;
---
<BaseLayout
  title={title}
  description={metaDescription}
  type="article"
  publishedTime={date.toISOString()}
  modifiedTime={updated?.toISOString()}
  tags={tags}
  image={new URL(`/og/${post.id}.png`, Astro.site).href}
  contentLicense
  locale={lang}
  alternates={alternates}
>
  <article>
    <h1 class="text-3xl font-bold mb-2">{title}</h1>
    <p class="text-muted text-sm mb-4">
      <time datetime={date.toISOString()}>{date.toLocaleDateString(dateLocale)}</time>{updated && (
        <Fragment> · {t.updatedOn} <time datetime={updated.toISOString()}>{updated.toLocaleDateString(dateLocale)}</time></Fragment>
      )} · {category}
    </p>
    {tags.length > 0 && (
      <p class="flex flex-wrap gap-2 mb-6">
        {tags.map((tag) => (
          <a href={l(`/tags/${encodeURIComponent(tag)}/`)} class="text-xs bg-surface border border-line rounded px-2 py-1 text-accent hover:underline">#{tag}</a>
        ))}
      </p>
    )}

    {translation && (
      <aside class="bg-surface border border-line rounded p-3 mb-6 text-sm" lang={lang === 'en' ? undefined : 'en'}>
        🌐 {t.translationNote}
        <a href={postUrl(translation)} class="text-accent hover:underline" lang={HTML_LANG[postLang(translation)]}>{t.translationLink}</a>
      </aside>
    )}

    {series && (
      <aside class="bg-surface border border-line rounded p-4 mb-6 text-sm">
        <p class="font-bold mb-2">
          {t.seriesLabel}{seriesByName.has(series)
            ? <a href={l(`/start/#${seriesByName.get(series)!.slug}`)} class="text-ink hover:text-accent no-underline">{series}</a>
            : series}
        </p>
        <ol class="list-decimal list-inside space-y-1 m-0">
          {seriesPosts.map((p) => (
            <li>
              {p.id === post.id
                ? <span class="text-ink">{p.data.title}{t.thisPost}</span>
                : <a href={blogUrl(p)} class="text-accent hover:underline">{p.data.title}</a>}
            </li>
          ))}
        </ol>
      </aside>
    )}

    {showToc && <Toc headings={tocHeadings} locale={lang} />}

    <div class="prose prose-invert max-w-none">
      <slot />
    </div>

    {series && (prevPost || nextPost) && (
      <nav class="flex justify-between gap-4 mt-8 text-sm">
        <span>{prevPost && <a href={blogUrl(prevPost)} class="text-accent hover:underline">← {prevPost.data.title}</a>}</span>
        <span>{nextPost && <a href={blogUrl(nextPost)} class="text-accent hover:underline">{nextPost.data.title} →</a>}</span>
      </nav>
    )}

    {backlinkGroups.length > 0 && (
      <aside class="mt-12 pt-6 border-t border-line text-sm">
        <p class="font-bold mb-2">{t.referencedIn}</p>
        {backlinkGroups.map((g) => (
          <div class="mb-3">
            <p class="text-muted text-xs mb-1">{g.label}</p>
            <ul class="list-none p-0 m-0 space-y-1">
              {g.sources.map((s) => (
                <li><a href={blogUrl(s)} class="text-accent hover:underline">{s.data.title}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </aside>
    )}

    <AuthorCard />
    {post.data.comments !== false && <Comments issueNumber={post.data.commentsIssue} />}
  </article>
</BaseLayout>
