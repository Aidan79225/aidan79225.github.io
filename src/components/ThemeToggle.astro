---
// Dark ⇄ light switch. The chosen skin lands on <html data-theme> and is
// persisted in localStorage; BaseLayout's head script re-applies it before
// first paint so there's no flash. Everything else in the site reads the
// six colour tokens, so flipping the attribute is the whole switch.
import { currentLocale } from '../lib/i18n';
const label = currentLocale(Astro.currentLocale) === 'en' ? 'Toggle colour theme' : '切換深色/淺色主題';
---
<button
  type="button"
  id="theme-toggle"
  class="text-ink hover:text-accent border border-line rounded px-2 py-1 leading-none cursor-pointer bg-transparent"
  aria-label={label}
  title={label}
  aria-pressed="false"
>
  <span class="theme-icon-dark" aria-hidden="true">🌙</span>
  <span class="theme-icon-light" aria-hidden="true">☀️</span>
</button>

<style>
  /* Show the icon for the skin you'd switch *to*. */
  :global(:root[data-theme="light"]) .theme-icon-dark,
  :global(:root:not([data-theme="light"])) .theme-icon-light {
    display: none;
  }
</style>

<script>
  const THEME_COLOR = { dark: '#1f2330', light: '#ffffff' };
  const btn = document.getElementById('theme-toggle');
  const root = document.documentElement;

  const sync = () => {
    const light = root.dataset.theme === 'light';
    btn?.setAttribute('aria-pressed', String(light));
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', light ? THEME_COLOR.light : THEME_COLOR.dark);
  };

  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Private-mode storage refusal: the switch still works for this page.
    }
    sync();
    // Anything that can't read CSS tokens — the <canvas> graph, the utterances
    // iframe — repaints on this.
    dispatchEvent(new CustomEvent('themechange', { detail: { theme: next } }));
  });

  sync();
</script>
