---
import Search from './Search.jsx';
import ThemeToggle from './ThemeToggle.astro';
import { currentLocale, withLocale } from '../lib/i18n';
// Under /en/ every route exists (real page or zh fallback), so nav links keep
// the visitor inside the /en/ prefix.
const locale = currentLocale(Astro.currentLocale);
const items = [
  { title: 'Home', url: '/' },
  { title: 'Start Here', url: '/start/' },
  { title: 'Map', url: '/graph/' },
  { title: 'About', url: '/about/' },
  { title: 'Tech', url: '/tech/' },
  { title: 'Food', url: '/food/' },
  { title: 'Guides', url: '/guides/' },
  { title: 'Tools', url: '/tools/' },
];
---
<nav class="bg-surface border-b border-line">
  <div class="max-w-3xl mx-auto px-4 py-3 flex flex-wrap items-center gap-x-4 gap-y-2">
    <ul class="flex flex-wrap gap-4 list-none m-0">
      {items.map((i) => (
        <li><a href={withLocale(locale, i.url)} class="text-ink hover:text-accent no-underline">{i.title}</a></li>
      ))}
    </ul>
    <div class="w-full sm:w-auto sm:ml-auto flex items-center gap-2">
      <Search client:load locale={locale} />
      <ThemeToggle />
    </div>
  </div>
</nav>
