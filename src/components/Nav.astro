---
import Search from './Search.jsx';
const items = [
  { title: 'Home', url: '/' },
  { title: 'About', url: '/about/' },
  { title: 'Tech', url: '/tech/' },
  { title: 'Food', url: '/food/' },
  { title: 'Guides', url: '/guides/' },
  { title: 'Tools', url: '/tools/' },
];
---
<nav class="bg-surface border-b border-line">
  <div class="max-w-3xl mx-auto px-4 py-3 flex flex-wrap items-center gap-x-4 gap-y-2">
    <ul class="flex flex-wrap gap-4 list-none m-0">
      {items.map((i) => (
        <li><a href={i.url} class="text-ink hover:text-accent no-underline">{i.title}</a></li>
      ))}
    </ul>
    <div class="w-full sm:w-auto sm:ml-auto">
      <Search client:load />
    </div>
  </div>
</nav>
